---
import SocialLinks from '@/components/SocialLinks.astro';
// src/components/hobbies/HobbiesDesktop.astro
import { Image } from "astro:assets";
const { hobbies, lastUpdated } = Astro.props;
---
<div class="flex flex-col h-full py-20">
<div class="rounded-lg bg-base-100/50 hover:shadow-xl transition ease-in-out hover:scale-[101%] mb-20 mx-10">
<div class="hero-content flex-row p-8">
<div class="grow w-full text-left">
<h1 class="text-6xl font-extrabold mb-4 text-white">Hobbies</h1>
<p class="text-xl opacity-80 text-gray-300 leading-relaxed">除了寫程式，這些是我投入熱情的地方。點擊下方圖片可以查看相關的貼文紀錄。</p>
</div>
</div>
</div>
<div class="flex flex-row justify-center items-center gap-10 mb-20 px-10">
{hobbies.map((hobby) => (
<a href={`/hobbies/${hobby.tag}`} class="group flex flex-col items-center flex-1 min-w-[180px] max-w-[220px] transition-all duration-500 hover:scale-110">
<div class="relative w-full aspect-square flex items-center justify-center">
<Image src={hobby.img} alt={hobby.name} class="h-auto w-full object-contain drop-shadow-2xl group-hover:drop-shadow-[0_20px_40px_rgba(59,130,246,0.4)] transition-all duration-500" />
</div>
<div class="mt-8 text-2xl font-bold opacity-0 group-hover:opacity-100 transition-all duration-300 text-blue-400 text-center tracking-widest">{hobby.name}</div>
<div class="h-1 w-0 group-hover:w-full bg-blue-500/50 transition-all duration-700 mt-2"></div>
</a>
))}
</div>
<footer class="w-full py-8 px-10 border-t border-white/10 mt-auto bg-transparent">
<div class="max-w-7xl mx-auto flex justify-between items-center">
<div class="flex flex-col gap-2">
<div class="text-gray-400 text-sm font-mono tracking-widest uppercase">
Last Updated : <span class="text-white font-bold">{lastUpdated}</span>
</div>
<div class="text-gray-400 text-sm font-mono tracking-widest uppercase">
Establish At : <span class="text-white font-bold">2026.02.16</span>
</div>
</div>
<div class="flex gap-4">
<SocialLinks />
</div>
</div>
</footer>
</div>