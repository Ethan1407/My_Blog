---
// src/components/hobbies/RunningCalendar.astro
// 跑步月曆：可切換月份、顏色深淺代表當天距離、點擊日期顯示距離、每列右側為該週跑量。
// 資料於 build 時從 intervals.icu 取得（每週一自動重新部署更新）。
import { DAY_MS, parseDate, toDateStr, weekStartOf, type RunningData } from '@/utils/running';

interface Props { data: RunningData }
const { today, kmByDay } = Astro.props.data;

const todayMs = parseDate(today);
const [ty, tm] = today.split('-').map(Number);
const pad = (n: number) => String(n).padStart(2, '0');
const fmt = (km: number) => km.toFixed(1);

const kmOf = (ms: number) => kmByDay[toDateStr(ms)] ?? 0;
const weekKm = (weekStartMs: number) =>
  Array.from({ length: 7 }, (_, i) => kmOf(weekStartMs + i * DAY_MS)).reduce((a, b) => a + b, 0);

// 本週 / 上週（週日～週六）跑量
const thisWeekKm = weekKm(weekStartOf(todayMs));
const lastWeekKm = weekKm(weekStartOf(todayMs) - 7 * DAY_MS);

// 某個月的總跑量
const monthTotal = (y: number, m: number) => {
  const prefix = `${y}-${pad(m)}`;
  return Object.entries(kmByDay).filter(([d]) => d.startsWith(prefix)).reduce((s, [, km]) => s + km, 0);
};

// 要顯示的月份：從第一筆有資料的月份到本月
const runDates = Object.keys(kmByDay).sort();
const first = runDates[0] ?? today;
let [fy, fm] = first.split('-').map(Number);
const months: { y: number; m: number }[] = [];
while (fy < ty || (fy === ty && fm <= tm)) {
  months.push({ y: fy, m: fm });
  fm === 12 ? ((fy += 1), (fm = 1)) : (fm += 1);
}

// 依距離分 5 級顏色
const level = (km: number) =>
  km === 0 ? 'bg-white/5'
  : km < 3 ? 'bg-blue-500/25'
  : km < 6 ? 'bg-blue-500/45'
  : km < 10 ? 'bg-blue-500/70'
  : km < 15 ? 'bg-blue-500/90'
  : 'bg-blue-400';
const legend = [0, 2, 5, 8, 12, 20].map(level);

const monthViews = months.map(({ y, m }) => {
  const prefix = `${y}-${pad(m)}`;
  const firstMs = Date.UTC(y, m - 1, 1);
  const lastMs = Date.UTC(y, m, 0);
  const weeks: { weekStartMs: number; days: ({ date: string; day: number; km: number; future: boolean } | null)[] }[] = [];
  for (let w = weekStartOf(firstMs); w <= lastMs; w += 7 * DAY_MS) {
    weeks.push({
      weekStartMs: w,
      days: Array.from({ length: 7 }, (_, i) => {
        const ms = w + i * DAY_MS;
        if (ms < firstMs || ms > lastMs) return null;
        return { date: toDateStr(ms), day: new Date(ms).getUTCDate(), km: kmOf(ms), future: ms > todayMs };
      }),
    });
  }
  const [py, pm] = m === 1 ? [y - 1, 12] : [y, m - 1];
  const isCurrent = y === ty && m === tm;
  return {
    label: `${y}.${pad(m)}`,
    weeks,
    monthKm: monthTotal(y, m),
    prevMonthKm: monthTotal(py, pm),
    runDays: Object.keys(kmByDay).filter((d) => d.startsWith(prefix)).length,
    // 看本月時顯示「本月 / 上月」，切到其他月份時顯示「9 月 / 8 月」
    monthLabel: isCurrent ? '本月' : `${m} 月`,
    prevMonthLabel: isCurrent ? '上月' : `${pm} 月`,
  };
});

const weekdays = ['日', '一', '二', '三', '四', '五', '六'];
const lastIdx = monthViews.length - 1;
---

<section class="mb-10 lg:mb-16" data-running-calendar>
  <h2 class="text-2xl font-bold text-white mb-8 flex items-center gap-3">
    <span class="w-8 h-[2px] bg-blue-500"></span> 跑步紀錄
  </h2>

  <div class="bg-white/5 p-4 md:p-8 rounded-2xl border border-white/5 flex flex-col md:flex-row gap-8 md:gap-12">
    <!-- 月曆 -->
    <div class="w-full md:w-fit md:mx-0">
      {monthViews.map((mv, idx) => (
        <div data-month={idx} data-km-total={fmt(mv.monthKm)} data-prev-km-total={fmt(mv.prevMonthKm)}
          data-days-total={mv.runDays} data-label={mv.monthLabel} data-prev-label={mv.prevMonthLabel} class={idx === lastIdx ? '' : 'hidden'}>
          <div class="flex items-center justify-between mb-4">
            <button type="button" data-nav="-1" aria-label="上個月"
              class="w-7 h-7 rounded-md text-gray-300 hover:bg-white/10 disabled:opacity-20 disabled:hover:bg-transparent"
              disabled={idx === 0}>‹</button>
            <span class="font-mono font-bold text-white tracking-widest">{mv.label}</span>
            <button type="button" data-nav="1" aria-label="下個月"
              class="w-7 h-7 rounded-md text-gray-300 hover:bg-white/10 disabled:opacity-20 disabled:hover:bg-transparent"
              disabled={idx === lastIdx}>›</button>
          </div>

          <div class="grid grid-cols-[repeat(7,minmax(0,1fr))_2.75rem] md:grid-cols-[repeat(7,2.5rem)_4rem] gap-1 md:gap-2 text-center">
            {weekdays.map((w) => <span class="text-xs text-gray-500">{w}</span>)}
            <span class="text-xs text-gray-500">週跑量</span>

            {mv.weeks.map((wk) => (
              <>
                {wk.days.map((c) =>
                  c === null ? (
                    <span></span>
                  ) : (
                    <button type="button"
                      data-date={c.date} data-km={c.km.toFixed(2)}
                      aria-label={`${c.date}${c.km ? `：${c.km.toFixed(2)} km` : ''}`}
                      class={`w-full aspect-square md:w-10 md:h-10 rounded-lg text-xs font-mono flex items-center justify-center transition hover:ring-1 hover:ring-white/50 ${level(c.km)} ${c.km ? 'text-white' : 'text-gray-500'} ${c.date === today ? 'outline outline-1 outline-white/70' : ''} ${c.future ? 'opacity-30 pointer-events-none' : ''}`}
                    >{c.day}</button>
                  )
                )}
                <span class="text-xs font-mono text-gray-400 self-center text-right">
                  {wk.weekStartMs <= todayMs ? fmt(weekKm(wk.weekStartMs)) : ''}
                </span>
              </>
            ))}
          </div>
        </div>
      ))}

      <!-- 圖例 -->
      <div class="flex items-center gap-1 mt-4 text-[10px] text-gray-500 font-mono">
        <span class="mr-1">少</span>
        {legend.map((cls) => <span class={`w-4 h-4 rounded ${cls}`}></span>)}
        <span class="ml-1">多</span>
      </div>

      <!-- 點擊後顯示的距離 -->
      <p data-detail class="mt-3 text-sm font-mono text-gray-400 min-h-[1.5rem]">點擊日期查看當天距離</p>
    </div>

    <!-- 統計 -->
    <div class="flex-1 flex flex-col justify-center gap-6 font-mono">
      <!-- 月：跟著目前選擇的月份變動 -->
      <div class="grid grid-cols-3 md:grid-cols-1 gap-6">
        <div>
          <div class="text-gray-400 text-xs tracking-widest"><span data-prev-label>{monthViews[lastIdx].prevMonthLabel}</span>跑量</div>
          <div class="text-2xl md:text-3xl font-bold text-white"><span data-prev-month-km>{fmt(monthViews[lastIdx].prevMonthKm)}</span><span class="text-sm text-gray-400 ml-1">km</span></div>
        </div>
        <div>
          <div class="text-gray-400 text-xs tracking-widest"><span data-label>{monthViews[lastIdx].monthLabel}</span>跑量</div>
          <div class="text-2xl md:text-3xl font-bold text-white"><span data-month-km>{fmt(monthViews[lastIdx].monthKm)}</span><span class="text-sm text-gray-400 ml-1">km</span></div>
        </div>
        <div>
          <div class="text-gray-400 text-xs tracking-widest">跑步天數</div>
          <div class="text-2xl md:text-3xl font-bold text-white"><span data-run-days>{monthViews[lastIdx].runDays}</span><span class="text-sm text-gray-400 ml-1">天</span></div>
        </div>
      </div>

      <!-- 週：固定以更新當天為準 -->
      <div class="grid grid-cols-3 md:grid-cols-1 gap-6 pt-6 border-t border-white/10">
        <div>
          <div class="text-gray-400 text-xs tracking-widest">上週跑量</div>
          <div class="text-2xl md:text-3xl font-bold text-white">{fmt(lastWeekKm)}<span class="text-sm text-gray-400 ml-1">km</span></div>
        </div>
        <div>
          <div class="text-gray-400 text-xs tracking-widest">本週跑量</div>
          <div class="text-2xl md:text-3xl font-bold text-white">{fmt(thisWeekKm)}<span class="text-sm text-gray-400 ml-1">km</span></div>
        </div>
      </div>
    </div>
  </div>
  <p class="mt-3 text-xs text-gray-500 font-mono">資料來源：Garmin · intervals.icu · 每週一更新 · 最後更新 {today}</p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-running-calendar]').forEach((root) => {
    const months = [...root.querySelectorAll<HTMLElement>('[data-month]')];
    const detail = root.querySelector<HTMLElement>('[data-detail]')!;
    const monthKm = root.querySelector<HTMLElement>('[data-month-km]')!;
    const runDays = root.querySelector<HTMLElement>('[data-run-days]')!;
    const prevMonthKm = root.querySelector<HTMLElement>('[data-prev-month-km]')!;
    const label = root.querySelector<HTMLElement>('span[data-label]')!;
    const prevLabel = root.querySelector<HTMLElement>('span[data-prev-label]')!;
    let current = months.length - 1;
    let selected: HTMLElement | null = null;

    const show = (idx: number) => {
      if (idx < 0 || idx >= months.length) return;
      months[current].classList.add('hidden');
      months[idx].classList.remove('hidden');
      current = idx;
      monthKm.textContent = months[idx].dataset.kmTotal ?? '0.0';
      runDays.textContent = months[idx].dataset.daysTotal ?? '0';
      prevMonthKm.textContent = months[idx].dataset.prevKmTotal ?? '0.0';
      label.textContent = months[idx].dataset.label ?? '';
      prevLabel.textContent = months[idx].dataset.prevLabel ?? '';
    };

    root.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const nav = target.closest<HTMLElement>('[data-nav]');
      if (nav) return show(current + Number(nav.dataset.nav));

      const cell = target.closest<HTMLElement>('[data-date]');
      if (!cell) return;
      selected?.classList.remove('ring-2', 'ring-white');
      cell.classList.add('ring-2', 'ring-white');
      selected = cell;
      const km = Number(cell.dataset.km);
      const [, m, d] = cell.dataset.date!.split('-');
      detail.innerHTML = km > 0
        ? `${Number(m)}/${Number(d)}：<span class="text-white font-bold">${km.toFixed(2)} km</span>`
        : `${Number(m)}/${Number(d)}：沒有跑步`;
    });
  });
</script>
