---
import SocialLinks from '@/components/SocialLinks.astro';
// src/components/hobbies/HobbiesMobile.astro
import { Image } from "astro:assets";
const { hobbies, lastUpdated } = Astro.props;
---
<div class="flex flex-col w-full bg-transparent">
<div class="rounded-lg bg-base-100/50 hover:shadow-xl transition ease-in-out hover:scale-[101%] mb-12 mx-6 mt-16">
<div class="hero-content flex-col p-6">
<div class="grow w-full text-center">
<h1 class="text-4xl font-extrabold mb-3 text-white">Hobbies</h1>
<p class="text-base opacity-80 text-gray-300 leading-relaxed">除了寫程式，這些是我投入熱情的地方。</p>
</div>
</div>
</div>
<div class="flex flex-col justify-center items-center gap-10 mb-20 px-10">
{hobbies.map((hobby) => (
<a href={`/hobbies/${hobby.tag}`} class="group flex flex-col items-center w-full max-w-[180px] transition-all duration-500">
<div class="relative w-full aspect-square flex items-center justify-center">
<Image src={hobby.img} alt={hobby.name} class="h-auto w-full object-contain drop-shadow-2xl" />
</div>
<div class="mt-4 text-xl font-bold opacity-100 text-blue-400 text-center tracking-widest">{hobby.name}</div>
<div class="h-1 w-12 bg-blue-500/50 mt-2"></div>
</a>
))}
</div>
<footer class="w-full py-8 px-6 border-t border-white/10 bg-transparent">
<div class="max-w-7xl mx-auto flex flex-col gap-6 items-center justify-center text-center">
<div class="text-gray-400 text-xs font-mono tracking-widest uppercase">Last Updated : <span class="text-white font-bold">{lastUpdated}</span></div>
<div class="text-gray-400 text-xs font-mono tracking-widest uppercase">Establish At : <span class="text-white font-bold">2026.02.16</span></div>
<div class="flex gap-4">
<SocialLinks />
</div>
</div>
</footer>
</div>