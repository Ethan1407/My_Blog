---
import ViewCounter from '@/components/ViewCounter.astro';
import SocialLinks from '@/components/SocialLinks.astro';
// src/components/projects/ProjectMobile.astro
// 用於單個專案詳情頁面的手機版
const { entry, filteredHeadings, lastUpdated, Content, wordCount } = Astro.props;
---
<div class="block w-full bg-transparent">
<header class="p-10 pt-28 border-b border-white/10 w-full bg-[#050b1a]">
<h1 class="text-4xl font-black text-white mb-3 tracking-tighter leading-tight">{entry.data.title}</h1>
<p class="text-gray-400 text-sm font-mono uppercase tracking-widest">📅 {entry.data.date} • 📍 {entry.data.location} • 📝 {wordCount} 字</p>
</header>
<main class="p-6 w-full prose-custom bg-transparent">
<article class="text-gray-200 leading-relaxed">
<Content />
</article>
</main>
<footer class="w-full py-8 px-6 border-t border-white/10 bg-transparent">
<div class="flex flex-col gap-10 items-center text-center">
<div class="text-gray-400 text-[10px] font-mono uppercase tracking-[0.2em]">Last Updated : <span class="text-white font-bold">{lastUpdated}</span></div>
<ViewCounter class="text-gray-400 text-[10px] font-mono uppercase tracking-[0.2em]" />
<div class="flex gap-4 justify-center">
<SocialLinks />
</div>
</div>
</footer>
</div>