---
// src/components/projects/ProjectDesktop.astro
const { entry, filteredHeadings, lastUpdated, Content, wordCount } = Astro.props;
import { Image } from 'astro:assets';
---
<div class="max-w-[1600px] mx-auto w-full flex flex-row gap-8 xl:gap-20 p-6 md:p-12 relative overflow-hidden h-[calc(100vh-120px)]">
<aside class="lg:w-[280px] shrink-0">
<div class="sticky top-24 overflow-hidden">
<h2 class="text-gray-500 font-bold text-xs uppercase tracking-[0.2em] mb-8 border-b border-white/5 pb-2">Contents</h2>
<nav><ul class="space-y-5" id="toc-list">
{filteredHeadings.map((h) => (
<li class={`transition-all duration-200 ${h.depth === 3 ? 'ml-5' : ''}`}>
<a href={`#${h.slug}`} data-heading-slug={h.slug} class="toc-link text-gray-400 hover:text-white text-[15px] leading-relaxed block hover:translate-x-1 transition-all duration-300">{h.text}</a>
</li>
))}
</ul></nav>
<div class="mt-16 pt-8 border-t border-white/5">
<a href="/projects" class="text-gray-500 hover:text-blue-400 transition-colors text-sm inline-flex items-center gap-2 group">
<span class="group-hover:-translate-x-1 transition-transform">←</span> Back to Projects
</a>
</div>
</div>
</aside>
<main class="flex-1 min-w-0 max-w-4xl flex flex-col lg:pl-24 overflow-y-auto hide-scrollbar">
<header class="mb-16 border-b border-white/10 pb-10">
<h1 class="text-5xl font-extrabold mb-8 text-white tracking-tight leading-tight">{entry.data.title}</h1>
<div class="flex flex-wrap gap-6 text-gray-400 text-lg">
<span class="flex items-center gap-2">📅 {entry.data.date}</span>
<span class="flex items-center gap-2">📍 {entry.data.location}</span>
<span class="flex items-center gap-2">📝 {wordCount} 字</span>
<div class="flex gap-2">
{entry.data.tags.map(tag => (
<span class="bg-white/5 px-3 py-1 rounded text-sm text-white/60">#{tag}</span>
))}
</div>
</div>
</header>
<article class="prose-custom flex-1">
<Content />
</article>
<div class="h-32"></div>
<footer class="w-full py-8 px-10 border-t border-white/10 bg-transparent mt-auto">
<div class="max-w-7xl mx-auto flex justify-between items-center">
<div class="flex flex-col gap-2">
<div class="text-gray-400 text-sm font-mono tracking-widest uppercase">Last Updated : <span class="text-white font-bold">{lastUpdated}</span></div>
<div class="text-gray-400 text-sm font-mono tracking-widest uppercase">Establish At : <span class="text-white font-bold">2026.02.16</span></div>
</div>
<div class="flex gap-4">
