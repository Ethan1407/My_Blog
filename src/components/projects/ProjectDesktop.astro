---
import GlobalFooter from '@/components/GlobalFooter.astro';
import MobileDrawer from '@/components/MobileDrawer.astro';
// src/components/projects/ProjectDesktop.astro
const { entry, filteredHeadings, Content, wordCount } = Astro.props;
import { Image } from 'astro:assets';
import { tagLabel } from '@/utils/tags';
import PostLinkPreview from './PostLinkPreview.astro';
---
<div class="max-w-[1600px] mx-auto w-full flex flex-col lg:flex-row gap-8 xl:gap-20 p-5 md:p-12 relative lg:overflow-hidden lg:h-[calc(100vh-120px)]">
<MobileDrawer class="lg:w-[280px] shrink-0">
<div class="lg:sticky lg:top-24 toc-scroll custom-scrollbar">
<h2 class="text-gray-500 font-bold text-xs uppercase tracking-[0.2em] mb-8 border-b border-white/5 pb-2">Contents</h2>
<nav><ul class="space-y-5" id="toc-list">
{filteredHeadings.map((h) => (
<li class={`transition-all duration-200 ${h.depth === 3 ? 'ml-5' : ''}`}>
<a href={`#${h.slug}`} data-heading-slug={h.slug} class="toc-link text-gray-400 hover:text-white text-[15px] leading-relaxed block hover:translate-x-1 transition-all duration-300">{h.text}</a>
</li>
))}
</ul></nav>
<div class="mt-16 pt-8 border-t border-white/5">
<a href="/projects" class="text-gray-500 hover:text-blue-400 transition-colors text-sm inline-flex items-center gap-2 group">
<span class="group-hover:-translate-x-1 transition-transform">←</span> Back to Projects
</a>
</div>
</div>
</MobileDrawer>
<main data-toc-root class="flex-1 min-w-0 max-w-4xl flex flex-col lg:pl-24 lg:overflow-y-auto hide-scrollbar">
<header class="mb-8 lg:mb-16 border-b border-white/10 pb-6 lg:pb-10">
<h1 class="text-3xl lg:text-5xl font-extrabold mb-4 lg:mb-8 text-white tracking-tight leading-tight lg:leading-tight">{entry.data.title}</h1>
<div class="flex flex-wrap gap-x-4 gap-y-2 lg:gap-6 text-gray-400 text-sm lg:text-lg">
<span class="flex items-center gap-2">📅 {entry.data.date}</span>
<span class="flex items-center gap-2">📍 {entry.data.location}</span>
<span class="flex items-center gap-2">📝 {wordCount} 字</span>
<div class="flex flex-wrap gap-2">
{entry.data.tags.map(tag => (
<span class="bg-white/5 px-3 py-1 rounded text-sm text-white/60">#{tagLabel(tag)}</span>
))}
</div>
</div>
</header>
<article class="prose-custom flex-1">
<Content />
</article>
<div class="h-8 lg:h-32"></div>
<GlobalFooter />
</main>
<PostLinkPreview entry={entry} />
</div>
<style>
@media (min-width: 1024px) {
.toc-scroll {
max-height: min(calc(14 * 1.75rem + 13 * 1.25rem + 10rem), calc(100vh - 8rem));
overflow-y: auto;
padding-right: 0.5rem;
}
}
</style>
<script is:inline>
// 使用 IntersectionObserver 来检测标题进入视口
let currentActiveSlug = null;

function setActiveLink(slug) {
if (currentActiveSlug === slug) return;
currentActiveSlug = slug;

const tocLinks = document.querySelectorAll('.toc-link');
tocLinks.forEach((link) => {
const linkSlug = link.getAttribute('data-heading-slug');
if (linkSlug === slug) {
link.classList.remove('text-gray-400');
link.classList.add('text-white', 'font-bold', 'translate-x-1');
} else {
link.classList.remove('text-white', 'font-bold', 'translate-x-1');
link.classList.add('text-gray-400');
}
});
}

function initializeHeadingObserver() {
const mainElement = document.querySelector('[data-toc-root]');
if (!mainElement) return;

const headings = Array.from(mainElement.querySelectorAll('h2, h3')).filter(h => h.id);
if (headings.length === 0) return;

// IntersectionObserver 选项：当标题进入 main 顶部 20% 的位置时触发
// 桌面版捲動的是 main，手機版捲動的是整個頁面
const observerOptions = {
root: window.matchMedia('(min-width: 1024px)').matches ? mainElement : null,
rootMargin: '0px 0px -80% 0px',
threshold: 0
};

const observer = new IntersectionObserver((entries) => {
entries.forEach((entry) => {
if (entry.isIntersecting) {
setActiveLink(entry.target.id);
}
});
}, observerOptions);

// 观察所有标题
headings.forEach((heading) => {
observer.observe(heading);
});
}

// 页面加载完成后初始化
if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', initializeHeadingObserver);
} else {
initializeHeadingObserver();
}
</script>