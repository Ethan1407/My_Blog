---
// src/components/StarryBackground.astro
---
<canvas id="starry-canvas" class="fixed top-0 left-0 w-full h-full -z-10"></canvas>

<script>
  const initStarfield = () => {
    const canvas = document.getElementById('starry-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    // 避免 DOMContentLoaded 與 astro:page-load 重複啟動多個動畫迴圈
    if (canvas.dataset.initialized) return;
    canvas.dataset.initialized = 'true';
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let stars = [];
    const isMobile = window.innerWidth < 768; // md breakpoint
    const starCount = isMobile ? 80 : 220; // 粒子數量 (手機80個，桌面220個)
    const connectionDist = 140; // 連線的最大距離
    const connectionDistSq = connectionDist * connectionDist;
    const mouseRadius = 150; // 滑鼠排斥影響範圍
    
    // 🔵 修改為深藍色背景
    const bgColor = "#050b1a"; 

    const mouse = { x: -9999, y: -9999 };

    function resize() {
      const dpr = window.devicePixelRatio || 1;
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0); // 用 setTransform 避免多次 resize 時縮放累加
      canvas.style.width = `${window.innerWidth}px`;
      canvas.style.height = `${window.innerHeight}px`;
      initStars();
    }

    function initStars() {
      stars = [];
      for (let i = 0; i < starCount; i++) {
        stars.push({
          x: Math.random() * window.innerWidth,
          y: Math.random() * window.innerHeight,
          size: Math.random() * 1.5 + 0.7,
          vx: (Math.random() - 0.5) * 0.5, 
          vy: (Math.random() - 0.5) * 0.5, 
          opacity: Math.random() * 0.4 + 0.3, // 亮度 0.3~0.7，保持柔和但不會消失
          twinkleSpeed: Math.random() * 0.02 + 0.005,
          twinklePhase: Math.random() * Math.PI * 2
        });
      }
    }

    function draw() {
      ctx.fillStyle = bgColor;
      ctx.fillRect(0, 0, window.innerWidth, window.innerHeight);

      stars.forEach((star, i) => {
        // 1. 滑鼠排斥邏輯
        const dx = star.x - mouse.x;
        const dy = star.y - mouse.y;
        const dist = Math.sqrt(dx * dx + dy * dy);

        if (dist < mouseRadius) {
          const force = (mouseRadius - dist) / mouseRadius;
          const angle = Math.atan2(dy, dx);
          star.x += Math.cos(angle) * force * 5;
          star.y += Math.sin(angle) * force * 5;
        }

        // 2. 基本漂浮移動
        star.x += star.vx;
        star.y += star.vy;

        if (star.x < 0) star.x = window.innerWidth;
        if (star.x > window.innerWidth) star.x = 0;
        if (star.y < 0) star.y = window.innerHeight;
        if (star.y > window.innerHeight) star.y = 0;

        // 3. 繪製星星（含閃爍與光暈）
        star.twinklePhase += star.twinkleSpeed;
        const alpha = star.opacity * (0.75 + 0.25 * Math.sin(star.twinklePhase));

        // 外圈柔和光暈
        const glowRadius = star.size * 3;
        const glow = ctx.createRadialGradient(star.x, star.y, 0, star.x, star.y, glowRadius);
        glow.addColorStop(0, `rgba(180, 215, 255, ${alpha * 0.2})`);
        glow.addColorStop(1, 'rgba(180, 215, 255, 0)');
        ctx.beginPath();
        ctx.arc(star.x, star.y, glowRadius, 0, Math.PI * 2);
        ctx.fillStyle = glow;
        ctx.fill();

        // 星星本體
        ctx.beginPath();
        ctx.arc(star.x, star.y, star.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;
        ctx.fill();

        // 4. 連線邏輯
        for (let j = i + 1; j < stars.length; j++) {
          const target = stars[j];
          const ddx = star.x - target.x;
          const ddy = star.y - target.y;
          const distSq = ddx * ddx + ddy * ddy;

          // 先用平方距離過濾，只有在範圍內才開根號，減少每幀的運算量
          if (distSq < connectionDistSq) {
            const distNext = Math.sqrt(distSq);
            ctx.beginPath();
            ctx.moveTo(star.x, star.y);
            ctx.lineTo(target.x, target.y);
            const lineOpacity = 1 - (distNext / connectionDist);
            // 稍微帶一點藍色的白線會更搭背景
            ctx.strokeStyle = `rgba(200, 230, 255, ${lineOpacity * 0.28})`;
            ctx.lineWidth = 0.6;
            ctx.stroke();
            ctx.closePath();
          }
        }
      });

      requestAnimationFrame(draw);
    }

    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });

    window.addEventListener('mouseleave', () => {
      mouse.x = -9999;
      mouse.y = -9999;
    });

    window.addEventListener('resize', resize);
    resize();
    draw();
  };

  document.addEventListener('DOMContentLoaded', initStarfield);
  document.addEventListener('astro:page-load', initStarfield);
</script>

<style>
  #starry-canvas {
    pointer-events: none;
    background-color: #050b1a; /* CSS 備援色 */
  }
</style>