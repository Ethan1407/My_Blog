---
// src/components/StarryBackground.astro
---
<canvas id="starry-canvas" class="fixed top-0 left-0 w-full h-full -z-10"></canvas>

<script>
  const initStarfield = () => {
    const canvas = document.getElementById('starry-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let stars = [];
    const starCount = 180; // 粒子數量
    const connectionDist = 120; // 連線的最大距離
    const mouseRadius = 150; // 滑鼠排斥影響範圍
    
    // 🔵 修改為深藍色背景
    const bgColor = "#050b1a"; 

    const mouse = { x: -9999, y: -9999 };

    function resize() {
      const dpr = window.devicePixelRatio || 1;
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      ctx.scale(dpr, dpr);
      canvas.style.width = `${window.innerWidth}px`;
      canvas.style.height = `${window.innerHeight}px`;
      initStars();
    }

    function initStars() {
      stars = [];
      for (let i = 0; i < starCount; i++) {
        stars.push({
          x: Math.random() * window.innerWidth,
          y: Math.random() * window.innerHeight,
          size: Math.random() * 1.5 + 0.5,
          vx: (Math.random() - 0.5) * 0.5, 
          vy: (Math.random() - 0.5) * 0.5, 
          opacity: Math.random()
        });
      }
    }

    function draw() {
      ctx.fillStyle = bgColor;
      ctx.fillRect(0, 0, window.innerWidth, window.innerHeight);

      stars.forEach((star, i) => {
        // 1. 滑鼠排斥邏輯
        const dx = star.x - mouse.x;
        const dy = star.y - mouse.y;
        const dist = Math.sqrt(dx * dx + dy * dy);

        if (dist < mouseRadius) {
          const force = (mouseRadius - dist) / mouseRadius;
          const angle = Math.atan2(dy, dx);
          star.x += Math.cos(angle) * force * 5;
          star.y += Math.sin(angle) * force * 5;
        }

        // 2. 基本漂浮移動
        star.x += star.vx;
        star.y += star.vy;

        if (star.x < 0) star.x = window.innerWidth;
        if (star.x > window.innerWidth) star.x = 0;
        if (star.y < 0) star.y = window.innerHeight;
        if (star.y > window.innerHeight) star.y = 0;

        // 3. 繪製星星
        ctx.beginPath();
        ctx.arc(star.x, star.y, star.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255, 255, 255, ${star.opacity})`;
        ctx.fill();

        // 4. 連線邏輯
        for (let j = i + 1; j < stars.length; j++) {
          const target = stars[j];
          const distNext = Math.sqrt(Math.pow(star.x - target.x, 2) + Math.pow(star.y - target.y, 2));
          
          if (distNext < connectionDist) {
            ctx.beginPath();
            ctx.moveTo(star.x, star.y);
            ctx.lineTo(target.x, target.y);
            const lineOpacity = 1 - (distNext / connectionDist);
            // 稍微帶一點藍色的白線會更搭背景
            ctx.strokeStyle = `rgba(200, 230, 255, ${lineOpacity * 0.2})`;
            ctx.lineWidth = 0.5;
            ctx.stroke();
            ctx.closePath();
          }
        }
      });

      requestAnimationFrame(draw);
    }

    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });

    window.addEventListener('mouseleave', () => {
      mouse.x = -9999;
      mouse.y = -9999;
    });

    window.addEventListener('resize', resize);
    resize();
    draw();
  };

  document.addEventListener('DOMContentLoaded', initStarfield);
  document.addEventListener('astro:page-load', initStarfield);
</script>

<style>
  #starry-canvas {
    pointer-events: none;
    background-color: #050b1a; /* CSS 備援色 */
  }
</style>