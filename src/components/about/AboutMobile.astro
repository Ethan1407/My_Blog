---
import SocialLinks from '@/components/SocialLinks.astro';
import { getLastUpdated } from '@/utils/lastUpdated';
// src/components/about/AboutMobile.astro
import { getCollection } from 'astro:content';
import ProfileSidebar from '../../features/About_Me/components/ProfileSidebar.astro';
import Timeline from '../../features/About_Me/components/Timeline.astro';
import TagSidebar from '../../features/About_Me/components/TagSidebar.astro';
import experienceData from '../../data/experience.json';
const projectEntries = await getCollection('projects');
const seenTitles = new Set();
const allEntries = [];
projectEntries.forEach(entry => { seenTitles.add(entry.data.title); allEntries.push(entry); });
experienceData.forEach(item => { if (!seenTitles.has(item.title)) { allEntries.push({ collection: 'experience_json', id: '', data: { ...item } }); } });
const sortedEvents = allEntries.sort((a, b) => {
const dateAStart = a.data.date.split('-')[0];
const dateBStart = b.data.date.split('-')[0];
const dateA = new Date(dateAStart.replace(/\./g, '-')).getTime();
const dateB = new Date(dateBStart.replace(/\./g, '-')).getTime();
return dateB - dateA;
});
const tagCountMap = {};
sortedEvents.forEach(entry => { const tags = entry.data.tags || []; tags.forEach(tag => { tagCountMap[tag] = (tagCountMap[tag] || 0) + 1; }); });
const sortedTags = Object.entries(tagCountMap).map(([name, count]) => ({ name, count })).sort((a, b) => b.count - a.count);
const categoryCountMap = {};
sortedEvents.forEach(entry => { const category = entry.data.category || ''; if (category) { categoryCountMap[category] = (categoryCountMap[category] || 0) + 1; } });
const sortedCategories = Object.entries(categoryCountMap).map(([name, count]) => ({ name, count })).sort((a, b) => b.count - a.count);
const lastUpdated = await getLastUpdated("2026.02.22");
---
<div data-period-root class="flex flex-col min-h-screen bg-[#050b1a] w-full relative">
<header class="p-10 pt-28 border-b border-white/10 w-full text-center bg-gradient-to-b from-blue-900/10 to-transparent">
<h1 class="text-4xl font-black text-white mb-2 tracking-tighter uppercase">About Me</h1>
<p class="text-blue-400/60 text-xs font-mono tracking-[0.3em]">ETHAN CHEN / PORTFOLIO</p>
</header>
<div class="flex w-full bg-[#0a1425]/90 backdrop-blur-xl border-b border-white/10 sticky top-0 z-50">
<button id="btn-profile" class="flex-1 py-4 flex flex-col items-center gap-1.5 text-[11px] font-bold text-white bg-blue-600/10 border-b-2 border-blue-500 transition-all duration-300">
<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
<span>自我介紹</span>
</button>
<button id="btn-timeline" class="flex-1 py-4 flex flex-col items-center gap-1.5 text-[11px] font-bold text-gray-500 border-b-2 border-transparent transition-all duration-300">
<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
<span>時間軸</span>
</button>
<button id="btn-tags" class="flex-1 py-4 flex flex-col items-center gap-1.5 text-[11px] font-bold text-gray-500 border-b-2 border-transparent transition-all duration-300">
<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5 4 4"></path><path d="M13 7 8.7 2.7a2 2 0 0 0-2.8 0L3.2 5.4a2 2 0 0 0 0 2.8L7.5 12.5"></path><path d="m9.9 8.6 3.2 3.2"></path><path d="M19 21h.01"></path><path d="M13 21h.01"></path><path d="M15 17h.01"></path><path d="M17 19h.01"></path></svg>
<span>篩選功能</span>
</button>
</div>
<main class="flex-1 w-full relative">
<div id="view-profile" class="p-6" style="display: block;"><ProfileSidebar /></div>
<div id="view-timeline" class="p-6" style="display: none;">
{sortedEvents.length > 0 ? <Timeline events={sortedEvents} /> : <p class="text-white text-center p-10">暫無資料</p>}
</div>
<div id="view-tags" class="p-8" style="display: none;">
<TagSidebar dates={sortedEvents.map(e => e.data.date)} monthDates={sortedEvents.filter(e => !e.data.milestone).map(e => e.data.date)} tags={sortedTags} categories={sortedCategories} />
</div>
</main>
<footer class="w-full py-10 px-6 border-t border-white/10 bg-transparent">
<div class="flex flex-col gap-6 items-center text-center">
<div class="text-gray-400 text-xs font-mono uppercase tracking-widest">Last Updated : <span class="text-white font-bold">{lastUpdated}</span></div>
<div class="flex gap-4">
<SocialLinks />
</div>
</div>
</footer>
</div>
<script is:inline>
function initAboutSwitcher() {
const bP = document.getElementById('btn-profile'); const bT = document.getElementById('btn-timeline'); const bG = document.getElementById('btn-tags');
const vP = document.getElementById('view-profile'); const vT = document.getElementById('view-timeline'); const vG = document.getElementById('view-tags');
const activeCls = "flex-1 py-4 flex flex-col items-center gap-1.5 text-[11px] font-bold text-white bg-blue-600/10 border-b-2 border-blue-500 transition-all duration-300";
const idleCls = "flex-1 py-4 flex flex-col items-center gap-1.5 text-[11px] font-bold text-gray-500 border-b-2 border-transparent transition-all duration-300";
if (!bP || !bT || !bG) return;
function resetTabs() {
[vP, vT, vG].forEach(v => v.style.display = 'none');
[bP, bT, bG].forEach(b => { b.className = idleCls; });
}
bP.onclick = () => { resetTabs(); vP.style.display = 'block'; bP.className = activeCls; window.scrollTo({ top: 0, behavior: 'smooth' }); };
bT.onclick = () => { resetTabs(); vT.style.display = 'block'; bT.className = activeCls; };
bG.onclick = () => { resetTabs(); vG.style.display = 'block'; bG.className = activeCls; };
}
function initMobileTimelineFilters() {
let selectedFilter = null;
const tagButtons = document.querySelectorAll('#view-tags .tag-button');
const categoryItems = document.querySelectorAll('#view-tags .filter-category');
const monthButtons = document.querySelectorAll('#view-tags .month-filter-btn');
const timelineEvents = document.querySelectorAll('#view-timeline .timeline-event');
const timelineTagBtns = document.querySelectorAll('#view-timeline .tag-button');
const clearBtn = document.querySelector('#view-tags .clear-all-filters');
function applyFilters() {
const activeTagName = (selectedFilter && selectedFilter.startsWith('tag:')) ? selectedFilter.substring(4) : null;
timelineEvents.forEach(evt => {
const eventTags = JSON.parse(evt.dataset.tags || '[]');
const eventCategory = evt.dataset.category || '';
let shouldShow = true;
if (selectedFilter) {
if (selectedFilter.startsWith('tag:')) { shouldShow = eventTags.includes(selectedFilter.substring(4)); }
else if (selectedFilter.startsWith('category:')) { shouldShow = eventCategory === selectedFilter.substring(9); }
else if (selectedFilter.startsWith('month:')) { shouldShow = evt.dataset.month === selectedFilter.substring(6); }
}
evt.style.display = shouldShow ? 'block' : 'none';
});
timelineTagBtns.forEach(tBtn => {
if (activeTagName && tBtn.dataset.tagName === activeTagName) {
tBtn.classList.remove('text-blue-300/80', 'bg-blue-400/10');
tBtn.classList.add('bg-white', 'text-black', 'font-black');
} else {
tBtn.classList.add('text-blue-300/80', 'bg-blue-400/10');
tBtn.classList.remove('bg-white', 'text-black', 'font-black');
}
});
if (clearBtn) clearBtn.style.display = selectedFilter ? 'block' : 'none';
}
function clearAllHighlights() {
tagButtons.forEach(btn => { btn.classList.remove('bg-white', 'text-[#424242]'); btn.classList.add('bg-[#5a5a5a]/60', 'text-white'); });
categoryItems.forEach(item => { item.classList.remove('text-white'); item.classList.add('text-gray-300'); });
monthButtons.forEach(btn => { btn.classList.remove('text-blue-400', 'font-bold', 'bg-white/10'); });
}
tagButtons.forEach(btn => {
btn.addEventListener('click', () => {
const tagName = btn.dataset.tagName;
const filterKey = 'tag:' + tagName;
if (selectedFilter === filterKey) { selectedFilter = null; clearAllHighlights(); }
else { clearAllHighlights(); selectedFilter = filterKey; btn.classList.add('bg-white', 'text-[#424242]'); btn.classList.remove('bg-[#5a5a5a]/60', 'text-white'); }
applyFilters();
});
});
categoryItems.forEach(item => {
item.addEventListener('click', () => {
const category = item.dataset.category;
const filterKey = 'category:' + category;
if (selectedFilter === filterKey) { selectedFilter = null; item.classList.remove('text-white'); item.classList.add('text-gray-300'); }
else { clearAllHighlights(); selectedFilter = filterKey; item.classList.add('text-white'); item.classList.remove('text-gray-300'); }
applyFilters();
});
});
monthButtons.forEach(btn => {
btn.addEventListener('click', () => {
const filterKey = 'month:' + btn.dataset.monthYear;
if (selectedFilter === filterKey) { selectedFilter = null; btn.classList.remove('text-blue-400', 'font-bold', 'bg-white/10'); }
else { clearAllHighlights(); selectedFilter = filterKey; btn.classList.add('text-blue-400', 'font-bold', 'bg-white/10'); }
applyFilters();
});
});
// 時間軸裡的標籤：等同點擊篩選頁中對應的標籤
timelineTagBtns.forEach(tBtn => {
tBtn.addEventListener('click', () => {
const sideBtn = Array.from(tagButtons).find(b => b.dataset.tagName === tBtn.dataset.tagName);
if (sideBtn) sideBtn.click();
});
});
if (clearBtn) { clearBtn.addEventListener('click', () => { selectedFilter = null; clearAllHighlights(); applyFilters(); }); }
const toggleTagsBtn = document.querySelector('#view-tags .toggle-tags-btn');
if (toggleTagsBtn) {
const moreTags = document.querySelectorAll('#view-tags .more-tag');
toggleTagsBtn.addEventListener('click', () => {
const isHidden = moreTags[0].classList.contains('hidden');
moreTags.forEach(tag => tag.classList.toggle('hidden'));
toggleTagsBtn.textContent = isHidden ? '顯示較少' : `顯示更多 (${moreTags.length})`;
});
}
}
initAboutSwitcher();
initMobileTimelineFilters();
document.addEventListener('astro:page-load', () => { initAboutSwitcher(); initMobileTimelineFilters(); });
</script>