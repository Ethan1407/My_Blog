---
import GlobalFooter from '@/components/GlobalFooter.astro';
import MobileDrawer from '@/components/MobileDrawer.astro';
// src/components/about/AboutDesktop.astro
import { getCollection } from 'astro:content';
// 🚀 關鍵修正：校正指向原 features 資料夾的路徑
import ProfileSidebar from '../../features/About_Me/components/ProfileSidebar.astro';
import Timeline from '../../features/About_Me/components/Timeline.astro';
import TagSidebar from '../../features/About_Me/components/TagSidebar.astro';
import experienceData from '../../data/experience.json';
const projectEntries = await getCollection('projects');
const seenTitles = new Set();
const allEntries = [];
projectEntries.forEach(entry => {
seenTitles.add(entry.data.title);
allEntries.push(entry);
});
experienceData.forEach(item => {
if (!seenTitles.has(item.title)) {
allEntries.push({ collection: 'experience_json', id: '', data: { ...item } });
}
});
const sortedEvents = allEntries.sort((a, b) => {
const dateAStart = a.data.date.split('-')[0];
const dateBStart = b.data.date.split('-')[0];
const dateA = new Date(dateAStart.replace(/\./g, '-')).getTime();
const dateB = new Date(dateBStart.replace(/\./g, '-')).getTime();
return dateB - dateA;
});
const tagCountMap = {};
sortedEvents.forEach(entry => {
const tags = entry.data.tags || [];
tags.forEach(tag => { tagCountMap[tag] = (tagCountMap[tag] || 0) + 1; });
});
const sortedTags = Object.entries(tagCountMap).map(([name, count]) => ({ name, count })).sort((a, b) => b.count - a.count);
const categoryCountMap = {};
sortedEvents.forEach(entry => {
const category = entry.data.category || '';
if (category) { categoryCountMap[category] = (categoryCountMap[category] || 0) + 1; }
});
const sortedCategories = Object.entries(categoryCountMap).map(([name, count]) => ({ name, count })).sort((a, b) => b.count - a.count);
---
<div id="about-desktop" data-period-root class="block lg:grid lg:grid-cols-[350px_1fr_280px] lg:grid-rows-[minmax(0,1fr)] h-full lg:divide-x divide-white/10 overflow-y-auto lg:overflow-hidden bg-transparent">
<aside class="min-h-0 p-5 lg:p-8 lg:overflow-y-auto overscroll-contain drag-scrollbar bg-transparent max-lg:border-b max-lg:border-white/10">
<ProfileSidebar />
</aside>
<main class="flex flex-col lg:h-full min-h-0 lg:overflow-y-auto overscroll-contain drag-scrollbar bg-transparent">
<div class="p-5 md:p-10 flex-1">
{sortedEvents.length > 0 ? (
<Timeline events={sortedEvents} />
) : (
<div class="text-white text-center p-20 border-2 border-dashed border-gray-500 bg-transparent">
<p class="text-xl">目前沒有資料，請確認資料夾或 JSON 內容。</p>
</div>
)}
</div>
<GlobalFooter />
</main>
<MobileDrawer class="lg:p-8 overflow-y-auto hide-scrollbar" menuTitle="篩選" showApply>
<TagSidebar tags={sortedTags} categories={sortedCategories} dates={sortedEvents.map(e => e.data.date)} monthDates={sortedEvents.filter(e => !e.data.milestone).map(e => e.data.date)} />
</MobileDrawer>
</div>
<style is:global>
.hide-scrollbar::-webkit-scrollbar { display: none; }
</style>
<script is:inline>
{
const root = document.getElementById('about-desktop');
const eventItems = root.querySelectorAll('.timeline-event');
const tagButtons = root.querySelectorAll('.tag-button');
const monthButtons = root.querySelectorAll('.month-filter-btn');
const categoryButtons = root.querySelectorAll('.filter-category');
const clearBtn = root.querySelector('.clear-all-filters');
const toggleBtn = root.querySelector('.toggle-tags-btn');
const moreTags = root.querySelectorAll('.more-tag');
let activeTag = null;
let activeMonth = null;
let activeCategory = null;
tagButtons.forEach(btn => { if (!btn.dataset.originalClass) btn.dataset.originalClass = btn.className; });
function applyFilter() {
eventItems.forEach(item => {
const itemTags = JSON.parse(item.getAttribute('data-tags') || '[]');
const itemMonth = item.getAttribute('data-month') || '';
const itemCategory = item.getAttribute('data-category') || '';
const matchTag = !activeTag || itemTags.includes(activeTag);
const matchMonth = !activeMonth || itemMonth === activeMonth;
const matchCategory = !activeCategory || itemCategory === activeCategory;
// 「進入大學 / 進入高中」等階段標籤在篩選時一律保留
const isMilestone = item.classList.contains('milestone-event');
item.style.display = (isMilestone || (matchTag && matchMonth && matchCategory)) ? '' : 'none';
});
tagButtons.forEach(btn => {
const original = btn.dataset.originalClass || '';
const isMatch = btn.getAttribute('data-tag-name') === activeTag;
btn.className = original;
btn.classList.toggle('filter-active', isMatch);
});
monthButtons.forEach(btn => {
const isMatch = btn.getAttribute('data-month-year') === activeMonth;
btn.classList.toggle('filter-active', isMatch);
});
categoryButtons.forEach(btn => {
const isMatch = btn.getAttribute('data-category') === activeCategory;
btn.classList.toggle('filter-active', isMatch);
});
if (activeTag || activeMonth || activeCategory) clearBtn?.classList.remove('hidden');
else clearBtn?.classList.add('hidden');
}
tagButtons.forEach(btn => { btn.addEventListener('click', () => { const tagName = btn.getAttribute('data-tag-name'); activeTag = (activeTag === tagName) ? null : tagName; applyFilter(); }); });
monthButtons.forEach(btn => { btn.addEventListener('click', () => { const mon = btn.getAttribute('data-month-year'); activeMonth = (activeMonth === mon) ? null : mon; applyFilter(); }); });
categoryButtons.forEach(btn => { btn.addEventListener('click', () => { const category = btn.getAttribute('data-category'); activeCategory = (activeCategory === category) ? null : category; applyFilter(); }); });
toggleBtn?.addEventListener('click', () => { const isHidden = moreTags[0].classList.contains('hidden'); moreTags.forEach(t => t.classList.toggle('hidden')); toggleBtn.textContent = isHidden ? '顯示較少' : `顯示更多 (${moreTags.length})`; });
clearBtn?.addEventListener('click', () => { activeTag = null; activeMonth = null; activeCategory = null; applyFilter(); });
}
</script>