---
// src/components/home/HomeDesktop.astro
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import astronautImg from './astronaut.webp';
const projectEntries = await getCollection('projects');
const parseProjectDate = (dateString) => {
  const normalizedDate = String(dateString).split('-')[0].trim().replace(/\./g, '-');
  return new Date(normalizedDate).getTime() || 0;
};
const latestPost = [...projectEntries].sort((a, b) => {
  return parseProjectDate(b.data.date) - parseProjectDate(a.data.date);
})[0];
---
<section class="relative min-h-[calc(100vh-80px)] flex flex-col items-center justify-center pt-16 pb-12 px-8 bg-transparent overflow-hidden">
<div class="z-10 text-center mb-205000 animate-fade-in-down">
<h1 class="text-7xl md:text-9xl font-black tracking-tighter text-white uppercase">
I'M <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-600 drop-shadow-[0_0_20px_rgba(59,130,246,0.4)]">ETHAN</span>
</h1>
</div>
<div class="relative z-10 w-80 md:w-[750px] animate-astronaut-float mb-16">
<Image src={astronautImg} alt="Floating Astronaut" class="w-full h-auto drop-shadow-[0_0_80px_rgba(59,130,246,0.3)]" />
<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-blue-600/10 rounded-full blur-[150px] -z-10"></div>
</div>
{latestPost && (
<a href={`/projects/${latestPost.slug}`} class="group z-10 flex items-center gap-4 px-8 py-4 rounded-full bg-white/5 backdrop-blur-md border border-white/10 hover:bg-white/10 hover:border-blue-400/50 transition-all duration-300 hover:scale-105 active:scale-95 shadow-2xl shadow-blue-900/20 whitespace-nowrap">
<span class="flex h-3 w-3 rounded-full bg-blue-400 animate-pulse flex-shrink-0"></span>
<span class="text-gray-400 text-sm font-bold tracking-widest uppercase flex-shrink-0">Latest Project</span>
<span class="text-white font-bold border-l border-white/20 pl-4 text-base md:text-lg truncate">
{latestPost.data.title}
</span>
<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400 group-hover:translate-x-2 transition-transform ml-2 flex-shrink-0"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
</a>
)}
</section>
<style>
@keyframes astronaut-float { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-40px) rotate(3deg); } }
.animate-astronaut-float { animation: astronaut-float 12s ease-in-out infinite; }
.animate-fade-in-down { animation: fadeInDown 1.5s cubic-bezier(0.16, 1, 0.3, 1); }
@keyframes fadeInDown { from { opacity: 0; transform: translateY(-40px); } to { opacity: 1; transform: translateY(0); } }
</style>