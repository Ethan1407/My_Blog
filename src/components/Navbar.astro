---
/**
 * Navbar 組件：新增搜尋功能
 * 點擊搜尋輸入文字並按下 Enter 後，將跳轉至 /search?q=關鍵字
 */
const { pathname } = Astro.url;
const isAbout = pathname.includes('about');
const isProjects = pathname.includes('projects');
const isHobbies = pathname.includes('hobbies');

const activeClass = "bg-[#424242] font-semibold text-white shadow-sm";
const inactiveClass = "text-gray-300 hover:text-white transition-colors";
---
<nav class="flex items-center justify-between px-8 py-4 bg-[#424242] border-b border-white relative z-10 h-[80px]">
    <a href="/" class="text-2xl cursor-pointer hover:opacity-80 transition-opacity">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
    </a>

    <div class="flex bg-[#5a5a5a] rounded-full p-1">
        <a href="/about" class={`px-6 py-2 rounded-full ${isAbout ? activeClass : inactiveClass}`}>About Me</a>
        <a href="/projects" class={`px-6 py-2 rounded-full ${isProjects ? activeClass : inactiveClass}`}>Projects</a>
        <a href="/hobbies" class={`px-6 py-2 rounded-full ${isHobbies ? activeClass : inactiveClass}`}>Hobbies</a>
    </div>

    <div class="flex items-center gap-6 text-2xl">
        <div class="relative flex items-center bg-[#5a5a5a] rounded-full px-3 py-1 group focus-within:ring-2 focus-within:ring-white/20 transition-all">
            <input 
                type="text" 
                id="nav-search-input"
                placeholder="Search..." 
                class="bg-transparent text-sm text-white placeholder-gray-400 outline-none w-0 group-hover:w-32 focus:w-48 transition-all duration-300 ease-in-out pl-2"
            />
            <button id="nav-search-btn" class="hover:scale-110 transition-transform p-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            </button>
        </div>

        <button class="hover:rotate-45 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
        </button>
        
        <div class="w-10 h-10 rounded-full bg-blue-400 overflow-hidden border-2 border-white/50 shadow-inner">
             <img src="https://picsum.photos/id/1036/100/100" alt="User" class="w-full h-full object-cover" />
        </div>
    </div>
</nav>

<script>
    const searchInput = document.getElementById('nav-search-input') as HTMLInputElement;
    const searchBtn = document.getElementById('nav-search-btn');

    const handleSearch = () => {
        const query = searchInput.value.trim();
        if (query) {
            // 跳轉至搜尋頁面，帶上查詢參數 q
            window.location.href = `/search?q=${encodeURIComponent(query)}`;
        }
    };

    // 監聽 Enter 鍵
    searchInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
            handleSearch();
        }
    });

    // 點擊圖示也可以搜尋
    searchBtn?.addEventListener('click', () => {
        if (searchInput.value.trim()) {
            handleSearch();
        } else {
            searchInput.focus();
        }
    });
</script>