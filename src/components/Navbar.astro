---
/**
 * Navbar 組件：搜尋擴張不移位版
 */
const { pathname } = Astro.url;
const isHome = pathname === '/';
const isAbout = pathname.includes('about');
const isProjects = pathname.includes('projects');
const isHobbies = pathname.includes('hobbies');

const activeClass = "bg-white/20 font-semibold text-white shadow-lg backdrop-blur-sm";
const inactiveClass = "text-gray-300 hover:text-white transition-colors";
---

<nav class="flex items-center justify-between px-8 py-4 bg-[#050b1a]/90 backdrop-blur-md border-b border-white/10 relative z-50 h-[80px]">
    
    <div class="flex items-center min-w-[100px]">
        <a href="/" class={`text-2xl cursor-pointer transition-all ${isHome ? 'text-blue-400 drop-shadow-[0_0_8px_rgba(96,165,250,0.5)]' : 'text-white hover:opacity-80'}`}>
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
        </a>
    </div>

    <div class="absolute left-1/2 -translate-x-1/2 flex bg-black/20 border border-white/5 rounded-full p-1 shadow-inner z-10">
        <a href="/about" class={`px-6 py-2 rounded-full transition-all duration-300 ${isAbout ? activeClass : inactiveClass}`}>About Me</a>
        <a href="/projects" class={`px-6 py-2 rounded-full transition-all duration-300 ${isProjects ? activeClass : inactiveClass}`}>Projects</a>
        <a href="/hobbies" class={`px-6 py-2 rounded-full transition-all duration-300 ${isHobbies ? activeClass : inactiveClass}`}>Hobbies</a>
    </div>

    <div class="flex items-center gap-6 text-2xl">
        <div class="relative flex items-center bg-white/10 border border-white/5 rounded-full px-3 py-1 group focus-within:ring-2 focus-within:ring-blue-400/50 transition-all">
            <input 
                type="text" 
                id="nav-search-input"
                placeholder="Search..." 
                class="bg-transparent text-sm text-white placeholder-gray-500 outline-none w-0 group-hover:w-32 focus:w-48 transition-all duration-300 ease-in-out pl-2"
            />
            <button id="nav-search-btn" class="hover:scale-110 transition-transform p-1 text-white">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            </button>
        </div>

        <div class="w-10 h-10 rounded-full bg-blue-500/20 overflow-hidden border-2 border-white/20 shadow-lg shrink-0">
             <img src="https://picsum.photos/id/1036/100/100" alt="User Profile" class="w-full h-full object-cover" />
        </div>
    </div>
</nav>

<script>
    const searchInput = document.getElementById('nav-search-input') as HTMLInputElement;
    const searchBtn = document.getElementById('nav-search-btn');

    const handleSearch = () => {
        const query = searchInput.value.trim();
        if (query) {
            window.location.href = `/search?q=${encodeURIComponent(query)}`;
        }
    };

    searchInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') handleSearch();
    });

    searchBtn?.addEventListener('click', () => {
        if (searchInput.value.trim()) {
            handleSearch();
        } else {
            searchInput.focus();
        }
    });
</script>