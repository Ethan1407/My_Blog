---
import ViewCounter from '@/components/ViewCounter.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { getLastUpdated } from '@/utils/lastUpdated';
// src/components/GlobalFooter.astro
const lastUpdated = await getLastUpdated("2026.02.15");
---

<footer class="w-full py-8 px-5 lg:px-10 border-t border-white/10 bg-transparent mt-auto">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row gap-6 sm:justify-between sm:items-center">
    <div class="flex flex-col gap-2">
      <div class="text-gray-400 text-xs sm:text-sm font-mono tracking-widest uppercase">
        Last Updated : <span class="text-white font-bold">{lastUpdated}</span>
      </div>
      <div class="text-gray-400 text-xs sm:text-sm font-mono tracking-widest uppercase">
        Establish At : <span class="text-white font-bold">2026.02.16</span>
      </div>
      <ViewCounter class="text-gray-400 text-xs sm:text-sm font-mono tracking-widest uppercase" />
    </div>
    <div class="flex gap-4">
      <SocialLinks />
    </div>
  </div>
</footer>