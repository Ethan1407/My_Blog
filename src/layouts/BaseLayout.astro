---
// src/layouts/BaseLayout.astro
import StarryBackground from '../components/StarryBackground.astro'; 
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';

const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-Hant" class="bg-[#050b1a]"> 
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Ethan Chen</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  </head>
  
  <body class="bg-transparent text-white font-['Inter',sans-serif] h-screen overflow-hidden selection:bg-blue-500/30">
    
    <StarryBackground />

    <slot />

    <Analytics />

    <script>
      // 網站總訪客數：每個裝置的每個瀏覽器只算一次。
      // 第一次造訪（瀏覽器裡沒有標記）才 POST 讓數字 +1，之後都只 GET 讀取。
      const SEEN_KEY = 'vc_seen';
      let isNew = false;
      try { isNew = !localStorage.getItem(SEEN_KEY); } catch {}

      fetch('/api/views', { method: isNew ? 'POST' : 'GET' })
        .then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
        .then(({ visitors }: { visitors: number }) => {
          // 成功計入後才寫入標記，避免 API 失敗時漏算
          if (isNew) try { localStorage.setItem(SEEN_KEY, '1'); } catch {}
          document.querySelectorAll<HTMLElement>('[data-view-counter]').forEach((el) => {
            el.querySelector('[data-visitors]')!.textContent = visitors.toLocaleString('en-US');
            el.hidden = false;
          });
        })
        .catch(() => {});
    </script>

  </body>
</html>

<style is:global>
  /* 確保根節點不會帶有擋住 Canvas 的底色 */
  :root {
    background-color: transparent;
  }
  
  /* 自定義捲軸樣式：配合星空主題改為細緻半透明 */
  ::-webkit-scrollbar {
    width: 6px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  /* 篩選選中狀態（類型 / 時期 / 標籤 / 動態）：統一只變藍色 */
  .filter-active {
    color: #60a5fa !important;
  }
  .tag-button.filter-active {
    background-color: rgba(96, 165, 250, 0.12) !important;
    border-color: rgba(96, 165, 250, 0.6) !important;
  }

  /* 可拖曳捲軸：視覺細、可點擊範圍寬（14px），hover / 拖曳時變亮變粗 */
  .drag-scrollbar::-webkit-scrollbar {
    width: 14px;
  }
  .drag-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .drag-scrollbar::-webkit-scrollbar-thumb {
    min-height: 48px;
    background-color: rgba(255, 255, 255, 0.3);
    border: 4px solid transparent;
    background-clip: padding-box;
    border-radius: 999px;
    cursor: grab;
  }
  .drag-scrollbar::-webkit-scrollbar-thumb:hover {
    background-color: rgba(255, 255, 255, 0.55);
    border-width: 3px;
  }
  .drag-scrollbar::-webkit-scrollbar-thumb:active {
    background-color: rgba(147, 197, 253, 0.85);
    border-width: 3px;
    cursor: grabbing;
  }
  /* Firefox 不支援 ::-webkit-scrollbar，改用標準屬性 */
  @supports not selector(::-webkit-scrollbar) {
    .drag-scrollbar {
      scrollbar-width: auto;
      scrollbar-color: rgba(255, 255, 255, 0.4) transparent;
    }
  }
</style>