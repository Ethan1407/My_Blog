---
// src/layouts/BaseLayout.astro
import StarryBackground from '../components/StarryBackground.astro';
import StarryBackgroundMobile from '../components/StarryBackgroundMobile.astro';
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-Hant" class="bg-[#050b1a]"> 
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | Ethan Chen</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  </head>
  
  <body class="bg-transparent text-white font-['Inter',sans-serif] min-h-screen selection:bg-blue-500/30">
    
    <!-- 電腦版背景 -->
    <div class="hidden md:block">
      <StarryBackground />
    </div>
    
    <!-- 手機版背景 -->
    <StarryBackgroundMobile />

    <slot />

  </body>
</html>

<style is:global>
  /* 確保根節點不會帶有擋住 Canvas 的底色 */
  :root {
    background-color: transparent;
  }
  
  /* 自定義捲軸樣式：配合星空主題改為細緻半透明 */
  ::-webkit-scrollbar {
    width: 6px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.2);
  }
</style>