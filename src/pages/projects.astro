---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import NavbarMobile from '@/components/NavbarMobile.astro';
import ProjectsView from '@/features/Projects/ProjectsView.astro';
import ProjectsViewMobile from '@/features/Projects/ProjectsViewMobile.astro';
---

<BaseLayout title="Projects">
  <div class="flex flex-col h-screen overflow-hidden bg-transparent">
      <!-- 電腦版導覽列 -->
      <div class="hidden md:block">
        <Navbar />
      </div>
      
      <!-- 手機版導覽列 -->
      <NavbarMobile />
      
      <div class="flex-1 overflow-hidden">
          <!-- 電腦版內容 -->
          <div class="hidden md:flex h-full overflow-auto">
            <ProjectsView />
          </div>
          
          <!-- 手機版內容 -->
          <div class="md:hidden overflow-auto">
            <ProjectsViewMobile />
          </div>
      </div>
  </div>
</BaseLayout>