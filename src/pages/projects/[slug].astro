              </a>
            </div>
          </div>
        </footer>

        <div class="h-20"></div>
      </main>
    </div>
  </div>
</BaseLayout>

<script>
  // Table of Contents 高亮功能
  function updateActiveHeading() {
    const headings = document.querySelectorAll('.prose-custom h2, .prose-custom h3');
    const tocLinks = document.querySelectorAll('.toc-link');

    if (headings.length === 0 || tocLinks.length === 0) return;

    let activeHeadingSlug = null;

    for (let heading of headings) {
      const rect = heading.getBoundingClientRect();
      if (rect.top <= 150) {
        activeHeadingSlug = heading.id;
      } else {
        break;
      }
    }

    tocLinks.forEach((link) => {
      const slug = link.getAttribute('data-heading-slug');
      if (slug === activeHeadingSlug) {
        link.classList.remove('text-gray-400');
        link.classList.add('text-white', 'font-bold', 'translate-x-1');
      } else {
        link.classList.remove('text-white', 'font-bold', 'translate-x-1');
        link.classList.add('text-gray-400');
      }
    });
  }

  window.addEventListener('scroll', updateActiveHeading, { passive: true });
  updateActiveHeading();
</script>

<style is:global>
  html { scroll-behavior: smooth; }

  /* Markdown 內容樣式優化 */
  .prose-custom h2 { 
    @apply text-3xl font-bold mt-20 mb-8 text-white border-b border-white/10 pb-3 scroll-mt-28; 
  }
  .prose-custom h3 { 
    @apply text-2xl font-bold mt-12 mb-6 text-white/90 scroll-mt-28; 
  }
  .prose-custom p { @apply text-lg text-gray-300 leading-[1.8] mb-8; }
  .prose-custom ul { @apply list-disc ml-8 mb-8 text-gray-300 space-y-3; }
  .prose-custom pre { 
    @apply bg-[#1a1a1a] p-8 rounded-2xl overflow-x-auto mb-10 border border-white/5 shadow-2xl; 
  }
  .prose-custom code { @apply bg-white/10 px-1.5 py-0.5 rounded text-blue-300 font-mono text-[0.9em]; }
  
  /* 🚀 修正：圖片樣式統一管理 */
  .prose-custom img { 
    @apply rounded-3xl my-14 border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] object-cover;
    /* 這裡改成 75% 並置中 */
    width: 75% !important;
    display: block !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }

  .hide-scrollbar::-webkit-scrollbar { display: none; }
  .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>