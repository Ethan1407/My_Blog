---
// src/pages/projects/[slug].astro
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';

// 1. 產生所有專案的路徑
export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');
  return projectEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// 2. 取得該專案資料並渲染內容
const { entry } = Astro.props;
const { Content, headings } = await entry.render();

// 3. 過濾標題：僅保留 ## (depth 2) 與 ### (depth 3)
const filteredHeadings = headings.filter((h) => h.depth > 1 && h.depth < 4);

/**
 * 4. 自動抓取 GitHub 最新 Commit 時間 (為了與主頁 Footer 一致)
 */
let lastUpdated = "2026.02.15"; 
try {
  const response = await fetch(`https://api.github.com/repos/Ethan1407/My_Blog/commits?per_page=1`, {
    headers: { 'User-Agent': 'Astro-App' }
  });
  if (response.ok) {
    const commits = await response.json();
    if (commits.length > 0) {
      const date = new Date(commits[0].commit.committer.date);
      lastUpdated = date.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '.');
    }
  }
} catch (e) { console.error(e); }
---

<BaseLayout title={entry.data.title}>
  <div class="flex flex-col min-h-screen bg-transparent">
    <Navbar />
    
    <div class="max-w-[1600px] mx-auto w-full flex flex-col lg:flex-row gap-8 xl:gap-20 p-6 md:p-12 relative">
      
      <aside class="lg:w-[280px] shrink-0">
        <div class="sticky top-24 max-h-[calc(100vh-120px)] overflow-y-auto hide-scrollbar">
          <h2 class="text-gray-500 font-bold text-xs uppercase tracking-[0.2em] mb-8 border-b border-white/5 pb-2">
            Contents
          </h2>
          <nav>
            <ul class="space-y-5" id="toc-list">
              {filteredHeadings.map((h) => (
                <li class={`transition-all duration-200 ${h.depth === 3 ? 'ml-5' : ''}`}>
                  <a 
                    href={`#${h.slug}`}
                    data-heading-slug={h.slug}
                    class="toc-link text-gray-400 hover:text-white text-[15px] leading-relaxed block hover:translate-x-1 transition-all duration-300"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          
          <div class="mt-16 pt-8 border-t border-white/5">
            <a href="/projects" class="text-gray-500 hover:text-blue-400 transition-colors text-sm inline-flex items-center gap-2 group">
              <span class="group-hover:-translate-x-1 transition-transform">←</span> Back to Projects
            </a>
          </div>
        </div>
      </aside>

      <main class="flex-1 min-w-0 max-w-4xl flex flex-col">
        <header class="mb-16 border-b border-white/10 pb-10">
          <h1 class="text-5xl font-extrabold mb-8 text-white tracking-tight leading-tight">{entry.data.title}</h1>
          <div class="flex flex-wrap gap-6 text-gray-400 text-lg">
            <span class="flex items-center gap-2">📅 {entry.data.date}</span>
            <span class="flex items-center gap-2">📍 {entry.data.location}</span>
            <div class="flex gap-2">
              {entry.data.tags.map(tag => (
                <span class="bg-white/5 px-3 py-1 rounded text-sm text-white/60">#{tag}</span>
              ))}
            </div>
          </div>
        </header>

        <article class="prose-custom flex-1">
          <Content />
        </article>

        <div class="h-32"></div>

        <footer class="w-full py-8 px-10 border-t border-white/10 bg-transparent mt-auto">
          <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="text-gray-400 text-sm font-mono tracking-widest uppercase">
              Last Updated : <span class="text-white font-bold">{lastUpdated}</span>
            </div>
            <div class="flex gap-4">
              <a href="https://www.instagram.com/ethan._1407?igsh=YWpvcDllMW1ocGM%3D&utm_source=qr" target="_blank" class="p-2 bg-[#5a5a5a] rounded-lg hover:bg-[#777777] transition-all duration-300 shadow-md">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
              </a>
              <a href="https://discord.com/users/1251472862825545831" target="_blank" class="p-2 bg-[#5a5a5a] rounded-lg hover:bg-[#777777] transition-all duration-300 shadow-md">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.6853-.2761-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.5151.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0323 1.4913 4.0069 2.3961 5.9604 2.9921a.0779.0779 0 00.0848-.0276c.4635-.6344.8837-1.3132 1.2542-2.026a.0764.0764 0 00-.0415-1.0562c-.7249-.2744-1.4187-.5963-2.0825-.9605a.0786.0786 0 01-.0061-.1286c.1574-.1163.3148-.2361.4678-.3596a.0754.0754 0 01.0803-.012c4.1977 1.9136 8.7394 1.9136 12.9073 0a.0754.0754 0 01.0803.012c.1545.1235.3133.2433.4721.3596a.0786.0786 0 01-.0061.1286c-.6682.3685-1.3657.6932-2.1006.9697a.0764.0764 0 00-.0415 1.0562c.3744.7171.7975 1.4004 1.2656 2.0387a.0779.0779 0 00.0848.0276c1.9535-.596 3.9281-1.5008 5.9604-2.9921a.0835.0835 0 00.0312-.0561c.4895-5.2044-.7392-9.7525-3.6922-13.6787a.0684.0684 0 00-.0321-.0277zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.419-2.1568 2.419zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.419-2.1568 2.419z"/></svg>
