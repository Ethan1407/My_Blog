---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import ProjectDesktop from '@/components/projects/ProjectDesktop.astro';
import ProjectMobile from '@/components/projects/ProjectMobile.astro';
export async function getStaticPaths() {
const projectEntries = await getCollection('projects');
return projectEntries.map(entry => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const filteredHeadings = headings.filter((h) => h.depth > 1 && h.depth < 4);
let lastUpdated = "2026.02.22"; 
try {
const response = await fetch(`https://api.github.com/repos/Ethan1407/My_Blog/commits?per_page=1`, { headers: { 'User-Agent': 'Astro-App' } });
if (response.ok) {
const commits = await response.json();
if (commits.length > 0) {
const date = new Date(commits[0].commit.committer.date);
lastUpdated = date.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '.');
}
}
} catch (e) { console.error(e); }
---
<BaseLayout title={entry.data.title}>
<div class="flex flex-col w-full min-h-screen bg-transparent">
<Navbar />
<main class="w-full flex-1">
<div class="hidden lg:block w-full">
<ProjectDesktop entry={entry} filteredHeadings={filteredHeadings} lastUpdated={lastUpdated} Content={Content} />
</div>
<div class="block lg:active w-full">
<ProjectMobile entry={entry} filteredHeadings={filteredHeadings} lastUpdated={lastUpdated} Content={Content} />
</div>
</main>
</div>
</BaseLayout>
<style is:global>
html { scroll-behavior: smooth; overflow-y: auto !important; height: auto !important; }
body { overflow-x: hidden; height: auto !important; }
.custom-scrollbar::-webkit-scrollbar { width: 4px; }
.custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.2); border-radius: 10px; }
.prose-custom h2 { @apply text-3xl font-bold mt-20 mb-8 text-white border-b border-white/10 pb-3 scroll-mt-28; }
.prose-custom h3 { @apply text-2xl font-bold mt-12 mb-6 text-white/90 scroll-mt-28; }
.prose-custom p { @apply text-lg text-gray-300 leading-[1.8] mb-8; }
.prose-custom ul { @apply list-disc ml-8 mb-8 text-gray-300 space-y-3; }
.prose-custom pre { @apply bg-[#1a1a1a] p-8 rounded-2xl overflow-x-auto mb-10 border border-white/5 shadow-2xl; }
.prose-custom code { @apply bg-white/10 px-1.5 py-0.5 rounded text-blue-300 font-mono text-[0.9em]; }
.prose-custom img { @apply rounded-3xl my-14 border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] object-cover; width: 75% !important; display: block !important; margin-left: auto !important; margin-right: auto !important; }
@media (max-width: 1024px) { .prose-custom img { width: 100% !important; } }
</style>