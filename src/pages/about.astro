---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
// 🚀 引入物理隔離的電腦版與手機版組件
import AboutDesktop from '../components/about/AboutDesktop.astro';
import AboutMobile from '../components/about/AboutMobile.astro';
---
<BaseLayout title="About Me">
<div class="flex flex-col h-screen overflow-hidden bg-transparent">
<Navbar />
<div class="flex-1 overflow-hidden">
<div class="hidden lg:block h-full">
<AboutDesktop />
</div>
<div class="block lg:hidden h-full overflow-y-auto">
<AboutMobile />
</div>
</div>
</div>
</BaseLayout>