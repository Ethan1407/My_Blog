---
/**
 * About Me 頁面入口
 */
import { getCollection } from 'astro:content'; // 1. 引入抓取工具
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import AboutView from '../features/About_Me/AboutView.astro';

// 2. 抓取資料並轉換格式
const projectEntries = await getCollection('projects');
const events = projectEntries.map(project => ({
  ...project.data,
  id: project.id
}));
---

<BaseLayout title="About Me">
  <div class="flex flex-col h-screen overflow-hidden bg-transparent">
      <Navbar />
      
      <div class="flex-1 overflow-hidden">
          {/* 3. 把資料傳給 AboutView */}
          <AboutView events={events} />
      </div>
  </div>
</BaseLayout>