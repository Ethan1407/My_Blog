---
/**
 * About Me 頁面入口
 */
import { getCollection } from 'astro:content'; // 1. 引入抓取工具
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import NavbarMobile from '../components/NavbarMobile.astro';
import AboutView from '../features/About_Me/AboutView.astro';
import AboutViewMobile from '../features/About_Me/AboutViewMobile.astro';

// 2. 抓取資料並轉換格式
const projectEntries = await getCollection('projects');
const events = projectEntries.map(project => ({
  ...project.data,
  id: project.id
}));
---

<BaseLayout title="About Me">
  <div class="flex flex-col h-screen overflow-hidden bg-transparent">
      <!-- 電腦版導覽列 -->
      <div class="hidden md:block">
        <Navbar />
      </div>
      
      <!-- 手機版導覽列 -->
      <NavbarMobile />
      
      <div class="flex-1 overflow-hidden">
          {/* 電腦版內容 */}
          <div class="hidden md:block h-full overflow-auto">
            <AboutView events={events} />
          </div>
          
          {/* 手機版內容 */}
          <div class="md:hidden overflow-auto">
            <AboutViewMobile />
          </div>
      </div>
  </div>
</BaseLayout>