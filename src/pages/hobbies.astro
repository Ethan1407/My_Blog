---
import { getLastUpdated } from '@/utils/lastUpdated';
// src/pages/hobbies.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import HobbiesDesktop from "../components/hobbies/HobbiesDesktop.astro";
import HobbiesMobile from "../components/hobbies/HobbiesMobile.astro";
import bicycle from "../features/Hobbies/bicycle.png";
import billiard from "../features/Hobbies/billiard.png";
import bowling from "../features/Hobbies/bowling.png";
import volleyball from "../features/Hobbies/volleyball.png";
import diy from "../features/Hobbies/diy.png";
const hobbies = [
{ name: "單車", img: bicycle, tag: "單車" },
{ name: "撞球", img: billiard, tag: "撞球" },
{ name: "保齡球", img: bowling, tag: "保齡球" },
{ name: "排球", img: volleyball, tag: "排球" },
{ name: "手作", img: diy, tag: "手作" },
];
const lastUpdated = await getLastUpdated("2026.02.15");
---
<BaseLayout title="我的興趣 | Ethan Chen">
<div class="flex flex-col h-screen overflow-hidden bg-transparent">
<Navbar />
<div class="flex-1 overflow-hidden">
<div class="hidden lg:block h-full">
<HobbiesDesktop hobbies={hobbies} lastUpdated={lastUpdated} />
</div>
<div class="block lg:hidden h-full overflow-y-auto">
<HobbiesMobile hobbies={hobbies} lastUpdated={lastUpdated} />
</div>
</div>
</div>
</BaseLayout>