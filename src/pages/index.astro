---
import { getCollection } from 'astro:content';
import Timeline from '../components/Timeline.astro';

// 1. 抓取資料
const projectEntries = await getCollection('projects');

// 2. 重要：將資料扁平化，這樣 Timeline.astro 才能讀到 item.title, item.date
const events = projectEntries.map(project => ({
  ...project.data,  // 這會展開 title, date, location, content, tags 等
  id: project.id
}));
---

<html lang="zh-Hant">
  <body class="bg-[#424242] p-10">
    <main class="max-w-4xl mx-auto">
      {/* 傳入處理好的扁平化資料 */}
      <Timeline events={events} />
    </main>
  </body>
</html>