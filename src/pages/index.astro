---
// src/pages/index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import HomeDesktop from '@/components/home/HomeDesktop.astro';
import HomeMobile from '@/components/home/HomeMobile.astro';
let lastUpdated = "2026.02.22";
try {
const response = await fetch(`https://api.github.com/repos/Ethan1407/My_Blog/commits?per_page=1`, {
headers: { 'User-Agent': 'Astro-App' }
});
if (response.ok) {
const commits = await response.json();
if (commits.length > 0) {
const date = new Date(commits[0].commit.committer.date);
lastUpdated = date.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '.');
}
}
} catch (e) { console.error("GitHub API Error:", e); }
---
<BaseLayout title="Home | Ethan Chen">
<div class="flex flex-col min-h-screen bg-transparent">
<Navbar />
<main class="flex-1 flex flex-col">
<div class="hidden lg:block flex-1">
<HomeDesktop lastUpdated={lastUpdated} />
</div>
<div class="block lg:hidden flex-1">
<HomeMobile lastUpdated={lastUpdated} />
</div>
</main>
<footer class="w-full py-8 px-10 border-t border-white/10 bg-transparent mt-auto">
<div class="max-w-7xl mx-auto flex justify-between items-center text-center md:text-left">
<div class="text-gray-400 text-sm font-mono tracking-widest uppercase">
Last Updated : <span class="text-white font-bold">{lastUpdated}</span>
</div>
