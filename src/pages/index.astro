---
// 1. 引入必要工具與組件
import { getCollection } from 'astro:content';
import Timeline from '../components/Timeline.astro';
// 如果你有 Layout 組件，請記得引入（例如：import Layout from '../layouts/Layout.astro';）

/**
 * 2. 抓取資料
 * 使用 getCollection 抓取 'projects' 資料夾 (即 src/content/projects)
 */
const projectEntries = await getCollection('projects');

/**
 * 3. 格式轉換
 * 你的 Timeline.astro 預期收到的是「扁平」的物件 (例如 item.title)
 * 但 getCollection 回傳的是 { data: { ...frontmatter }, body: "..." }
 * 所以我們用 .map 把 data 裡的內容提取到最外層
 */
const events = projectEntries.map(project => ({
  title: project.data.title,
  date: project.data.date,
  location: project.data.location,
  category: project.data.category,
  content: project.data.content, // 對應你 md 裡的 content 欄位
  tags: project.data.tags,
  image: project.data.image
}));
---

<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <title>Ethan's Timeline</title>
    <style>
      /* 給背景一個深色底，才看得到白色的時間軸 */
      body {
        background-color: #424242;
        margin: 0;
        padding: 40px;
        font-family: sans-serif;
      }
    </style>
  </head>
  <body>
    <main class="max-w-4xl mx-auto">
      <Timeline events={events} />
    </main>
  </body>
</html>