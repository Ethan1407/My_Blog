---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/Navbar.astro";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const tags = ["單車", "撞球", "保齡球", "排球", "手作"];

  return tags.map((tag) => ({
    params: { tag },
    props: { 
      posts: allPosts.filter((post) => post.data.tags?.includes(tag)) 
    },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;

const descriptions: Record<string, string> = {
  "單車": "從武嶺挑戰到日常訓練，單車對我來說不只是運動，更是一種對自我極限的追求與破風的快感。我喜歡在公路上與風競爭的感覺，每一次踩踏都是與大地的對話。",
  "撞球": "撞球是一場關於角度與力道的幾何遊戲，我享受每一顆球精準進袋時的成就感。這不只是技巧，更是一場冷靜與專注力的磨練。",
  "保齡球": "在球道上尋找完美的旋轉角度，全倒時清脆的撞擊聲是我最有效的舒壓方式。這是一場與自己節奏的對抗，追求每一次出球的穩定。",
  "排球": "排球講求團隊默契與瞬間爆發力，我喜歡在球場上與隊友一同救球、進攻的熱血氛圍。在那小小的場地裡，球不落地，永不放棄。",
  "手作": "從無到有的創造過程充滿樂趣。動手實作讓我能更直觀地理解結構，並將腦中的想法實體化，這是我將創意落地的實驗室。"
};

let lastUpdated = "2026.02.16"; 
try {
  const response = await fetch(`https://api.github.com/repos/Ethan1407/My_Blog/commits?per_page=1`, {
    headers: { 'User-Agent': 'Astro-App' }
  });
  if (response.ok) {
    const commits = await response.json();
    if (commits.length > 0) {
      const date = new Date(commits[0].commit.committer.date);
      lastUpdated = date.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '.');
    }
  }
} catch (e) { console.error(e); }
---

<BaseLayout title={`關於 ${tag} | Ethan Chen`}>
  <div class="flex flex-col min-h-screen bg-transparent">
    <Navbar />
    
    <div class="max-w-[1600px] mx-auto w-full flex flex-col lg:flex-row gap-8 xl:gap-20 p-6 md:p-12 relative grow">
      
      <aside class="lg:w-[280px] shrink-0">
        <div class="sticky top-24 max-h-[calc(100vh-120px)] overflow-y-auto hide-scrollbar">
          <h2 class="text-gray-500 font-bold text-xs uppercase tracking-[0.2em] mb-8 border-b border-white/5 pb-2">
            Hobbies Navigation
          </h2>
          <nav>
            <ul class="space-y-5">
              <li>
                <a href="/hobbies/單車" class={`text-[15px] leading-relaxed block hover:translate-x-1 transition-all ${tag === '單車' ? 'text-blue-400 font-bold' : 'text-gray-400 hover:text-white'}`}># 單車 Cycling</a>
              </li>
              <li>
                <a href="/hobbies/撞球" class={`text-[15px] leading-relaxed block hover:translate-x-1 transition-all ${tag === '撞球' ? 'text-blue-400 font-bold' : 'text-gray-400 hover:text-white'}`}># 撞球 Billiard</a>
              </li>
              <li>
                <a href="/hobbies/保齡球" class={`text-[15px] leading-relaxed block hover:translate-x-1 transition-all ${tag === '保齡球' ? 'text-blue-400 font-bold' : 'text-gray-400 hover:text-white'}`}># 保齡球 Bowling</a>
              </li>
              <li>
                <a href="/hobbies/排球" class={`text-[15px] leading-relaxed block hover:translate-x-1 transition-all ${tag === '排球' ? 'text-blue-400 font-bold' : 'text-gray-400 hover:text-white'}`}># 排球 Volleyball</a>
              </li>
              <li>
                <a href="/hobbies/手作" class={`text-[15px] leading-relaxed block hover:translate-x-1 transition-all ${tag === '手作' ? 'text-blue-400 font-bold' : 'text-gray-400 hover:text-white'}`}># 手作 DIY</a>
              </li>
            </ul>
          </nav>
          
          <div class="mt-16 pt-8 border-t border-white/5">
            <a href="/hobbies" class="text-gray-500 hover:text-blue-400 transition-colors text-sm inline-flex items-center gap-2 group">
              <span class="group-hover:-translate-x-1 transition-transform">←</span> Back to Hobbies
            </a>
          </div>
        </div>
      </aside>

      <main class="flex-1 min-w-0 max-w-4xl flex flex-col">
        <header class="mb-12 border-b border-white/10 pb-10">
          <h1 class="text-5xl font-extrabold text-white tracking-tight leading-tight">關於 #{tag}</h1>
        </header>

        <article class="prose-custom mb-16">
          <div class="bg-white/5 p-8 rounded-2xl border-l-4 border-blue-500 shadow-2xl">
            <p class="text-xl italic text-gray-200 m-0">
              {descriptions[tag as string] || "這是我熱愛的活動之一，帶給我無限的動力。"}
            </p>
          </div>
        </article>

        <section class="mb-20">
          <h2 class="text-2xl font-bold text-white mb-8 flex items-center gap-3">
            <span class="w-8 h-[2px] bg-blue-500"></span> 相關貼文紀錄
          </h2>
          
          <div class="flex flex-col gap-6">
            {posts.length === 0 ? (
              <div class="bg-white/5 p-16 rounded-3xl text-center border border-dashed border-white/10">
                <p class="text-xl text-gray-500 italic">目前尚無關於 #{tag} 的貼文</p>
              </div>
            ) : (
              posts.map((post) => (
                <a href={"/blog/" + post.slug} class="group rounded-2xl bg-white/5 hover:bg-white/[0.08] transition-all duration-300 border border-white/5 hover:border-white/20 overflow-hidden">
                  <div class="flex flex-col md:flex-row items-center p-6 gap-6">
                    {post.data.heroImage && (
                      <img src={post.data.heroImage} alt={post.data.title} class="w-full md:w-48 h-32 rounded-xl object-cover transition-transform duration-500 group-hover:scale-105" />
                    )}
                    <div class="grow">
                      <h3 class="text-xl font-bold text-white group-hover:text-blue-400 transition-colors mb-2">
                        {post.data.title}
                        {post.data.badge && <span class="ml-3 text-[10px] uppercase tracking-widest bg-blue-500/20 text-blue-400 px-2 py-1 rounded">{post.data.badge}</span>}
                      </h3>
                      <p class="text-gray-400 text-sm line-clamp-2 leading-relaxed">{post.data.description}</p>
                    </div>
                  </div>
                </a>
              ))
            )}
          </div>
        </section>
      </main>
    </div>

    <footer class="w-full py-4 border-t border-white/10 mt-auto">
      <div class="max-w-[1600px] mx-auto flex flex-col md:flex-row justify-between items-center gap-4 px-12">
        <div class="text-gray-400 text-sm font-mono tracking-widest uppercase">
          Last Updated : <span class="text-white font-bold">{lastUpdated}</span>
        </div>
        <div class="flex gap-4">
          <a href="https://discord.com/users/1251472862825545831" target="_blank" class="p-2.5 bg-white/5 rounded-xl hover:bg-white/10 transition-all border border-white/5">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="white">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037 19.736 19.736 0 0 0-4.885 1.515.069.069 0 0 0-.032.027C.533 9.048-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.862-1.297 1.197-1.99a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.863-.886.077.077 0 0 1-.003-.129c.125-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.927 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.196.373.291a.077.077 0 0 1-.002.129 12.26 12.26 0 0 1-1.864.886.076.076 0 0 0-.041.106c.335.693.735 1.36 1.197 1.99a.078.078 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.086 2.157 2.419 0 1.334-.947 2.419-2.157 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.086 2.157 2.419 0 1.334-.946 2.419-2.157 2.419z"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/ethan._1407..." target="_blank" class="p-2.5 bg-white/5 rounded-xl hover:bg-white/10 transition-all border border-white/5"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg></a>
          <a href="https://github.com/Ethan1407" target="_blank" class="p-2.5 bg-white/5 rounded-xl hover:bg-white/10 transition-all border border-white/5"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg></a>
          <a href="mailto:ethanchen.pro@gmail.com" class="p-2.5 bg-white/5 rounded-xl hover:bg-white/10 transition-all border border-white/5"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg></a>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>

<style is:global>
  html { scroll-behavior: smooth; }
  .prose-custom p { @apply text-lg text-gray-300 leading-[1.8] mb-8; }
  .hide-scrollbar::-webkit-scrollbar { display: none; }
  .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>