---
// src/features/Hobbies/HobbiesViewMobile.astro
// 手機版興趣 - 使用圖片卡片垂直顯示
import { Image } from "astro:assets";
import bicycle from "./bicycle.png";
import billiard from "./billiard.png";
import bowling from "./bowling.png";
import volleyball from "./volleyball.png";
import diy from "./diy.png";

const hobbies = [
  { name: "Cycling", img: bicycle, tag: "cycling", description: "Started in 2021" },
  { name: "Billiards", img: billiard, tag: "billiards", description: "Started in 2023" },
  { name: "Bowling", img: bowling, tag: "bowling", description: "Started in 2026" },
  { name: "Volleyball", img: volleyball, tag: "volleyball", description: "Started in 2024" },
  { name: "Handcraft", img: diy, tag: "handcraft", description: "Started in 2022" },
];
---

<div class="md:hidden flex flex-col min-h-[calc(100vh-80px)] bg-transparent py-4 px-4 overflow-y-auto">
    
    <!-- 標題 -->
    <h2 class="text-3xl font-black text-white mb-2 text-center">My Hobbies</h2>
    <p class="text-gray-400 text-sm text-center mb-6">Things I'm passionate about</p>

    <!-- 興趣卡片網格 - 改為單列垂直 -->
    <div class="space-y-4">
        {hobbies.map((hobby) => (
            <a 
                href={`/hobbies/${hobby.tag}`}
                class="group block rounded-xl overflow-hidden bg-white/5 border border-white/10 hover:border-blue-400/50 transition-all hover:bg-white/10 active:scale-95"
            >
                <div class="relative h-40 overflow-hidden bg-gradient-to-br from-blue-500/5 to-purple-500/5">
                    <Image 
                        src={hobby.img} 
                        alt={hobby.name} 
                        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" 
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
                </div>
                
                <div class="p-4">
                    <h3 class="text-base font-bold text-white mb-1 group-hover:text-blue-400 transition-colors">
                        {hobby.name}
                    </h3>
                    <p class="text-gray-300 text-xs leading-relaxed mb-3">
                        {hobby.description}
                    </p>
                    <div class="flex items-center gap-1 text-blue-400 text-xs group-hover:translate-x-1 transition-transform">
                        <span class="font-semibold">View Posts</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </div>
                </div>
            </a>
        ))}
    </div>

    <div class="h-8"></div>
</div>

<style>
    @media (max-width: 768px) {
        ::-webkit-scrollbar {
            width: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.3);
            border-radius: 10px;
        }
    }
</style>
