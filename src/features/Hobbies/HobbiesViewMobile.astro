---
// src/features/Hobbies/HobbiesViewMobile.astro
// 手機版興趣 - 垂直堆疊，保持桌面版圖示和設計
import hobbiesData from '../../data/hobbies.json';

const icons: Record<string, string> = {
  cycling: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/></svg>`,
  billiards: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/><path d="m17 7-5 5"/></svg>`,
  bowling: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M10 8.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"/><path d="M14 10.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"/><path d="M11 13.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"/></svg>`,
  volleyball: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m12 2 4.5 9.5-8.5-4.5"/><path d="m20.5 7.5-9.5 4.5 4.5 8.5"/><path d="m3.5 16.5 9.5-4.5-4.5-8.5"/></svg>`,
  handcraft: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>`
};
---

<!-- 手機版興趣容器 - 垂直堆疊 -->
<div class="md:hidden flex flex-col h-[calc(100vh-80px)] bg-transparent overflow-y-auto custom-scrollbar">
    
    <!-- 標題區 -->
    <div class="sticky top-0 z-10 px-4 pt-6 pb-4 text-center bg-[#050b1a]/80 backdrop-blur">
        <h2 class="text-3xl font-black text-white mb-1">My Hobbies</h2>
        <p class="text-gray-400 text-sm">Things I'm passionate about</p>
    </div>

    <!-- 興趣卡片垂直列表 -->
    <div class="px-4 py-6 space-y-6 flex-1">
        {hobbiesData.map((hobby) => (
            <div class="flex flex-col items-center text-center group">
                
                {/* 圖示卡片 */}
                <div class={`
                    flex items-center justify-center w-28 h-28 rounded-3xl 
                    bg-[#050b1a]/50 border border-white/10 backdrop-blur-xl 
                    transition-all duration-500 
                    group-hover:scale-110 group-hover:border-blue-400 
                    group-hover:shadow-[0_0_40px_rgba(59,130,246,0.3)]
                    ${hobby.related_projects && hobby.related_projects.length > 0 ? 'cursor-pointer' : 'cursor-default'}
                `}>
                    <div 
                        class="text-gray-400 group-hover:text-blue-400 transition-colors duration-500" 
                        set:html={icons[hobby.id] || ''} 
                    />

                    {/* 單個相關專案時可點擊 */}
                    {hobby.related_projects && hobby.related_projects.length === 1 && (
                        <a 
                            href={`/projects/${hobby.related_projects[0].slug}`} 
                            class="absolute inset-0 rounded-3xl"
                            aria-label={`View ${hobby.name} project`}
                        ></a>
                    )}
                </div>

                {/* 文字內容區 */}
                <div class="mt-4">
                    <h3 class="text-white font-bold text-lg tracking-[0.15em] uppercase group-hover:text-blue-400 transition-colors">
                        {hobby.name}
                    </h3>
                    <p class="text-gray-400 text-xs mt-2 font-medium leading-relaxed opacity-70 group-hover:opacity-100 transition-opacity">
                        {hobby.description}
                    </p>
                    
                    {/* 底部裝飾線條 */}
                    <div class="h-[2px] w-0 group-hover:w-8 bg-gradient-to-r from-transparent via-blue-500 to-transparent transition-all duration-700 mx-auto mt-3"></div>
                </div>

            </div>
        ))}
    </div>

</div>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.3); border-radius: 10px; }
</style>
