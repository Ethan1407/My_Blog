---
/**
 * ProjectSidebar 組件
 * 1. 類型 (Type)：移除「專案」，保留競賽、筆記、活動、專題
 * 2. 視覺：維持極小間距與高資訊密度排版
 * 3. 功能：支援標籤與月份的複合過濾
 */
const { tags = [], yearlyStats = [] } = Astro.props;
const topTags = tags.slice(0, 5);
const otherTags = tags.slice(5);

const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
---
<div class="space-y-8">
    <section>
        <h2 class="text-lg font-bold mb-4 tracking-widest border-l-4 border-white pl-3 text-white uppercase">類型</h2>
        <ul class="space-y-0.5 text-base text-gray-300">
            {['競賽', '筆記', '活動', '專題'].map(item => (
                <li 
                    class="filter-category flex items-center hover:text-white cursor-pointer transition-colors group px-2 py-1 rounded-md" 
                    data-category={item}
                >
                    <span class="mr-2 text-white/30 group-hover:text-white text-xs">•</span> {item}
                </li>
            ))}
        </ul>
    </section>

    <section>
        <h2 class="text-lg font-bold mb-4 tracking-widest border-l-4 border-white pl-3 text-white uppercase">標籤</h2>
        <div class="flex flex-col gap-2">
            {tags.map((tag, index) => (
                <button 
                    class={`tag-button ${index >= 5 ? 'hidden more-tag' : ''} bg-[#5a5a5a]/60 hover:bg-[#7a7a7a] py-1 px-3.5 rounded-md text-sm font-bold transition-all flex items-center justify-between border border-white/5 group shadow-sm text-white`}
                    data-tag-name={tag.name}
                >
                    <span class="tracking-wide">{tag.name}</span>
                    <span class="bg-white/10 group-hover:bg-white/20 px-1.5 py-0.5 rounded text-[10px] font-bold text-white/60 group-hover:text-white min-w-[24px] text-center transition-colors">
                        {tag.count}
                    </span>
                </button>
            ))}

            {otherTags.length > 0 && (
                <button id="toggle-tags-btn" class="mt-1 text-[11px] font-bold text-gray-500 hover:text-white transition-colors text-center py-1 border border-dashed border-white/10 rounded-md">
                    顯示更多 ({otherTags.length})
                </button>
            )}
            
            <button id="clear-all-filters" class="hidden mt-2 text-[11px] font-bold text-blue-400 hover:text-blue-300 transition-colors text-left pl-1 uppercase tracking-tighter">
                ✕ 重置所有過濾
            </button>
        </div>
    </section>

    <section>
        <h2 class="text-lg font-bold mb-4 tracking-widest border-l-4 border-white pl-3 text-white uppercase">動態</h2>
        <div class="space-y-5">
            {yearlyStats.map((yearGroup) => (
                <div>
                    <h3 class="text-base font-bold text-white mb-2 flex items-center gap-2">
                        <div class="w-1 h-1 bg-blue-400 rounded-full shadow-[0_0_8px_rgba(96,165,250,0.8)]"></div>
                        {yearGroup.year}
                    </h3>
                    <div class="space-y-0.5 ml-3 border-l border-white/10 pl-3">
                        {yearGroup.months.map(([month, count]) => (
                            <button 
                                class="month-filter-btn flex justify-between items-center w-full text-gray-400 text-[13px] hover:text-white transition-all py-0.5 px-2 rounded hover:bg-white/5 group text-left"
                                data-month-year={`${yearGroup.year}.${String(monthNames.indexOf(month) + 1).padStart(2, '0')}`}
                            >
                                <span>{month}</span>
                                <span class="font-mono text-white/40 group-hover:text-white/80 text-xs">{count}</span>
                            </button>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </section>
</div>