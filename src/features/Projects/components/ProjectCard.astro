---
/**
 * ProjectCard 組件
 * 1. 語言同步：內容 -> content, 標籤 -> tags
 * 2. 條件渲染：若無 location 則不顯示該行
 */
const { project } = Astro.props;
const { title, location, content, date, image, tags, category } = project.data;
const slug = project.slug;

const tagsString = JSON.stringify(tags);
---
<a 
    href={`/projects/${slug}`} 
    data-tags={tagsString}
    data-category={category}
    data-date={date}
    class="project-card block bg-[#5a5a5a]/40 hover:bg-[#5a5a5a]/60 rounded-xl p-6 transition-all duration-300 group hover:-translate-y-1 hover:shadow-2xl border border-white/5 relative overflow-hidden mb-8"
>
    <div class="flex flex-col md:flex-row gap-6">
        {image && (
            <div class="md:w-1/3 aspect-video bg-gray-600 rounded-lg overflow-hidden border border-white/10">
                <img src={image} alt={title} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" />
            </div>
        )}

        <div class="flex-1 flex flex-col justify-between">
            <div>
                <h3 class="text-2xl font-bold mb-2 text-white group-hover:text-blue-400 transition-colors">{title}</h3>
                <div class="space-y-1 text-gray-300 text-lg">
                    {location && (
                        <p><span class="font-semibold text-white/80">location :</span> {location}</p>
                    )}
                    <p><span class="font-semibold text-white/80">content :</span> {content}</p>
                </div>

                <div class="mt-4 flex flex-wrap items-center gap-2">
                    <span class="text-sm font-bold text-white/60">tags :</span>
                    <div class="flex flex-wrap gap-2">
                        {tags.map((tag) => (
                            <span class="text-sm text-blue-300/80 bg-blue-400/10 px-2 py-0.5 rounded-md border border-blue-400/20">
                                {tag}
                            </span>
                        ))}
                    </div>
                </div>
            </div>
            
            <div class="flex justify-end items-center gap-4 mt-6">
                <div class="flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 bg-blue-400 rounded-full animate-pulse"></span>
                    <span class="text-sm font-bold text-blue-400 tracking-wider uppercase">{category}</span>
                </div>
                <span class="text-gray-400 font-mono text-sm tracking-tighter border-l border-white/10 pl-4">{date}</span>
            </div>
        </div>
    </div>
</a>