---
/**
 * FeaturedMarquee 推薦筆記跑馬燈
 * - 一行橫向自動捲動，只顯示標題；滑鼠移上去時暫停，並在下方浮出該筆記的完整簡介卡片
 * - 點標題或卡片可直接前往該筆記
 * - 顯示所有帶有「推薦」標籤的筆記（依日期新到舊）；要更換推薦筆記，直接改該篇 index.md 的 tags 即可
 */
import { getCollection } from 'astro:content';
import ProjectPreviewCard from './ProjectPreviewCard.astro';

const FEATURED_TAG = '推薦';

const featured = (await getCollection('projects'))
    .filter((p) => p.data.tags.includes(FEATURED_TAG))
    .sort((a, b) => b.data.date.localeCompare(a.data.date));
---

{featured.length > 0 && (
<section data-marquee class="featured-marquee relative mb-10 rounded-xl border border-white/10 bg-white/[0.03] flex items-stretch">
    <!-- 左側標籤 -->
    <div class="shrink-0 flex items-center gap-2 px-4 border-r border-white/10 bg-blue-500/10 rounded-l-xl">
        <span class="text-blue-400 text-sm">★</span>
        <span class="text-xs font-bold tracking-[0.2em] text-blue-300 uppercase whitespace-nowrap">推薦筆記</span>
    </div>

    <!-- 捲動區：腳本會依畫面寬度複製足夠的份數，並以「一份的寬度」為單位循環，讓標題永遠接續不斷 -->
    <div class="marquee-viewport relative flex-1 overflow-hidden py-3">
        <div class="marquee-track flex w-max">
            <ul class="marquee-group flex shrink-0">
                {featured.map((p) => (
                    <li class="flex items-center">
                        <a
                            href={`/projects/${p.id}`}
                            data-preview={p.id}
                            class="marquee-item px-6 text-[15px] font-semibold text-gray-300 hover:text-blue-400 transition-colors whitespace-nowrap"
                        >{p.data.title}</a>
                        <span class="text-white/20 text-xs">◆</span>
                    </li>
                ))}
            </ul>
        </div>
    </div>

    <!-- 懸浮簡介卡片（放在捲動區外，才不會被裁切；位置由下方腳本計算） -->
    {featured.map((p) => <ProjectPreviewCard project={p} />)}
</section>
)}

<style>
    /* 腳本量好寬度後才加上 is-ready 開始捲動；--shift = 一份內容的寬度 */
    .marquee-track.is-ready {
        animation: marquee-scroll var(--duration, 35s) linear infinite;
    }
    /* 滑鼠移到跑馬燈上（或正在看簡介卡片）時暫停 */
    .featured-marquee:hover .marquee-track,
    .featured-marquee.is-previewing .marquee-track {
        animation-play-state: paused;
    }
    /* 左右兩側淡出 */
    .marquee-viewport {
        mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
        -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    }
    @keyframes marquee-scroll {
        from { transform: translateX(0); }
        to   { transform: translateX(calc(var(--shift, 0px) * -1)); }
    }
    /* 系統設定「減少動態效果」時不自動捲動，改成可手動左右滑 */
    @media (prefers-reduced-motion: reduce) {
        .marquee-track.is-ready { animation: none; }
        .marquee-viewport { overflow-x: auto; }
    }
</style>

<script>
    import { positionPreviewCard } from '@/utils/previewCard';

    document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((root) => {
        const cards = new Map<string, HTMLElement>();
        root.querySelectorAll<HTMLElement>('[data-preview-card]').forEach((c) => cards.set(c.dataset.previewCard!, c));

        let active: HTMLElement | null = null;
        let hideTimer: number | undefined;

        const hide = () => {
            active?.classList.add('hidden');
            active = null;
            root.classList.remove('is-previewing');
        };
        const scheduleHide = () => {
            clearTimeout(hideTimer);
            hideTimer = window.setTimeout(hide, 150); // 留一點時間讓滑鼠移到卡片上
        };

        const show = (item: HTMLElement) => {
            clearTimeout(hideTimer);
            const card = cards.get(item.dataset.preview!);
            if (!card) return;
            if (active !== card) active?.classList.add('hidden');
            active = card;
            root.classList.add('is-previewing');
            card.classList.remove('hidden');

            positionPreviewCard(card, item);
        };

        // ---- 無縫循環：複製足夠份數，讓畫面上永遠排滿標題 ----
        const SPEED = 40; // 每秒移動幾 px
        const viewport = root.querySelector<HTMLElement>('.marquee-viewport')!;
        const track = root.querySelector<HTMLElement>('.marquee-track')!;
        const group = track.querySelector<HTMLElement>('.marquee-group')!;
        let lastSize = '';

        const layout = () => {
            const vw = viewport.clientWidth;
            const gw = group.offsetWidth;
            if (!vw || !gw || `${vw}:${gw}` === lastSize) return; // 隱藏中（例如手機版區塊在桌面上）先不處理
            lastSize = `${vw}:${gw}`;
            track.querySelectorAll('.marquee-clone').forEach((c) => c.remove());
            // 至少要「畫面寬度 + 一份」才能在移動一份的距離後完美接回起點
            const copies = Math.ceil(vw / gw) + 1;
            for (let i = 0; i < copies; i++) {
                const clone = group.cloneNode(true) as HTMLElement;
                clone.classList.add('marquee-clone');
                clone.setAttribute('aria-hidden', 'true');
                clone.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', '-1'));
                track.appendChild(clone);
            }
            track.style.setProperty('--shift', `${gw}px`);
            track.style.setProperty('--duration', `${gw / SPEED}s`);
            track.classList.add('is-ready');
        };
        // 畫面寬度改變、或字型載入後標題寬度改變時，重新計算
        const ro = new ResizeObserver(layout);
        ro.observe(viewport);
        ro.observe(group);

        // ---- 懸浮卡片（用事件委派，複製出來的標題也有效）----
        // 只有滑鼠才顯示懸浮卡片；手機點標題就直接進入筆記
        track.addEventListener('pointerover', (e) => {
            const item = (e.target as HTMLElement).closest<HTMLElement>('[data-preview]');
            if (item && e.pointerType === 'mouse') show(item);
        });
        track.addEventListener('pointerout', (e) => {
            if ((e.target as HTMLElement).closest('[data-preview]')) scheduleHide();
        });
        track.addEventListener('focusin', (e) => {
            const item = (e.target as HTMLElement).closest<HTMLElement>('[data-preview]');
            if (item) show(item);
        });
        track.addEventListener('focusout', scheduleHide);
        cards.forEach((card) => {
            card.addEventListener('pointerenter', () => clearTimeout(hideTimer));
            card.addEventListener('pointerleave', scheduleHide);
        });

        // 捲動頁面時卡片位置會錯開，直接收起
        root.closest('main')?.addEventListener('scroll', hide, { passive: true });
        window.addEventListener('resize', hide);
    });
</script>
