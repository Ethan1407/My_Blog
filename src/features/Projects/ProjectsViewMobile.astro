---
import { getCollection } from 'astro:content';
import ProjectCard from './components/ProjectCard.astro';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => b.data.date.localeCompare(a.data.date));

let lastUpdated = '2026.02.15'; 
try {
  const response = await fetch('https://api.github.com/repos/Ethan1407/My_Blog/commits?per_page=1', {
    headers: { 'User-Agent': 'Astro-App' }
  });
  if (response.ok) {
    const commits = await response.json();
    if (commits.length > 0) {
      const date = new Date(commits[0].commit.committer.date);
      lastUpdated = date.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '.');
    }
  }
} catch (e) {}
---

<div class='md:hidden flex flex-col min-h-[calc(100vh-80px)] bg-transparent overflow-y-auto custom-scrollbar py-4 px-4'>
    <h2 class='text-3xl font-black text-white mb-6 text-center'>Projects</h2>

    <div class='space-y-6 flex-1'>
        {sortedProjects.map(project => (
            <ProjectCard project={project} />
        ))}
    </div>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.3); }
</style>