---
import ViewCounter from '@/components/ViewCounter.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { getLastUpdated } from '@/utils/lastUpdated';
import { getCollection } from 'astro:content';
import ProjectCard from './components/ProjectCard.astro';
import ProjectSidebar from './components/ProjectSidebar.astro';
import ProjectMilestone from './components/ProjectMilestone.astro';
import { withMilestones } from '@/utils/milestones';
const allProjects = await getCollection('projects');
const tagMap = {};
allProjects.forEach(p => { p.data.tags.forEach(t => { tagMap[t] = (tagMap[t] || 0) + 1; }); });
const sortedTags = Object.entries(tagMap).map(([name, count]) => ({ name, count })).sort((a, b) => b.count - a.count);
const categoryMap = {};
allProjects.forEach(p => { const cat = p.data.category || ''; if (cat) categoryMap[cat] = (categoryMap[cat] || 0) + 1; });
const sidebarCategoriesOrder = ['競賽', '筆記', '活動', '專題'];
const categories = sidebarCategoriesOrder.map(name => ({ name, count: categoryMap[name] || 0 }));
const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const yearlyStatsMap = {};
allProjects.forEach(p => {
const dateParts = p.data.date.split('.');
const year = dateParts[0];
const monthIndex = parseInt(dateParts[1]) - 1 || 0;
const monthName = monthNames[monthIndex];
if (!yearlyStatsMap[year]) yearlyStatsMap[year] = {};
yearlyStatsMap[year][monthName] = (yearlyStatsMap[year][monthName] || 0) + 1;
});
const sortedYearlyStats = Object.entries(yearlyStatsMap).sort((a, b) => b[0].localeCompare(a[0])).map(([year, months]) => ({
year,
months: Object.entries(months).sort((a, b) => monthNames.indexOf(b[0]) - monthNames.indexOf(a[0]))
}));
const sortedProjects = allProjects.sort((a, b) => b.data.date.localeCompare(a.data.date));
const lastUpdated = await getLastUpdated("2026.02.15");
---
<div data-projects-root data-period-root class="flex flex-col w-full bg-transparent">
<header class="p-10 pt-6 border-b border-white/10 w-full text-center bg-gradient-to-b from-blue-900/10 to-transparent flex-shrink-0">
<h1 class="text-4xl font-black text-white mb-2 tracking-tighter uppercase">Projects</h1>
<p class="text-blue-400/60 text-xs font-mono tracking-[0.3em]">EXPLORE MY DEVELOPMENT PORTFOLIO</p>
</header>
<div class="flex w-full bg-[#0a1425]/90 backdrop-blur-xl border-b border-white/10 sticky top-0 z-50 flex-shrink-0">
<button id="btn-posts" class="flex-1 py-4 flex flex-col items-center gap-1.5 text-[11px] font-bold text-white bg-blue-600/10 border-b-2 border-blue-500">
<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"></path><path d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
<span>專案貼文</span>
</button>
<button id="btn-filter" class="flex-1 py-4 flex flex-col items-center gap-1.5 text-[11px] font-bold text-gray-500 border-b-2 border-transparent">
<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
<span>篩選功能</span>
</button>
</div>
<main class="w-full flex-1 overflow-y-auto">
<div id="view-posts" class="p-6 w-full">
<div class="space-y-6">{withMilestones(sortedProjects, p => p.data.date).map(entry => (entry.type === 'milestone' ? <ProjectMilestone milestone={entry.milestone} /> : <ProjectCard project={entry.item} />))}</div>
<div class="h-20"></div>
</div>
<div id="view-filter" class="p-6 w-full" style="display: none;">
<ProjectSidebar tags={sortedTags} yearlyStats={sortedYearlyStats} categories={categories} dates={sortedProjects.map(p => p.data.date)} />
<div class="h-20"></div>
</div>
</main>
<footer class="w-full py-8 px-6 border-t border-white/10 bg-transparent">
<div class="flex flex-col gap-6 items-center">
<div class="text-gray-400 text-xs font-mono tracking-widest uppercase">Last Updated : <span class="text-white font-bold">{lastUpdated}</span></div>
<ViewCounter class="text-gray-400 text-xs font-mono tracking-widest uppercase" />
<div class="flex gap-4">
<SocialLinks linkClass="p-2 border border-white/20 rounded-lg hover:bg-white/5 shadow-md" />
</div>
</div>
</footer>
</div>
<script is:inline>
function initProjectsToggle() {
const btnP = document.getElementById('btn-posts'); const btnF = document.getElementById('btn-filter');
const viewP = document.getElementById('view-posts'); const viewF = document.getElementById('view-filter');
if (!btnP || !btnF) return;
btnP.onclick = () => { viewP.style.display = 'block'; viewF.style.display = 'none'; btnP.className = "flex-1 py-4 flex flex-col items-center gap-1.5 text-[11px] font-bold text-white bg-blue-600/10 border-b-2 border-blue-500"; btnF.className = "flex-1 py-4 flex flex-col items-center gap-1.5 text-[11px] font-bold text-gray-500 border-b-2 border-transparent"; window.scrollTo({ top: 0, behavior: 'smooth' }); };
btnF.onclick = () => { viewP.style.display = 'none'; viewF.style.display = 'block'; btnF.className = "flex-1 py-4 flex flex-col items-center gap-1.5 text-[11px] font-bold text-white bg-blue-600/10 border-b-2 border-blue-500"; btnP.className = "flex-1 py-4 flex flex-col items-center gap-1.5 text-[11px] font-bold text-gray-500 border-b-2 border-transparent"; };
}
initProjectsToggle();
document.addEventListener('astro:page-load', initProjectsToggle);
</script>