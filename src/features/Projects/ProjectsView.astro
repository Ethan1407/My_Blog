---
import GlobalFooter from '@/components/GlobalFooter.astro';
import MobileDrawer from '@/components/MobileDrawer.astro';
import { getCollection } from 'astro:content';
import ProjectCard from './components/ProjectCard.astro';
import ProjectSidebar from './components/ProjectSidebar.astro';
import ProjectMilestone from './components/ProjectMilestone.astro';
import FeaturedMarquee from './components/FeaturedMarquee.astro';
import { withMilestones } from '@/utils/milestones';

// 1. 抓取所有專案
const allProjects = await getCollection('projects');

// 2. 處理標籤邏輯
const tagMap = {};
allProjects.forEach(p => {
    p.data.tags.forEach(t => {
        tagMap[t] = (tagMap[t] || 0) + 1;
    });
});
const sortedTags = Object.entries(tagMap)
    .map(([name, count]) => ({ name, count }))
    .sort((a, b) => b.count - a.count);

// 2b. 處理類型 (category) 統計，供側邊欄顯示數量
const categoryMap = {};
allProjects.forEach(p => {
    const cat = p.data.category || '';
    if (cat) categoryMap[cat] = (categoryMap[cat] || 0) + 1;
});
const sidebarCategoriesOrder = ['競賽', '筆記', '活動', '專題'];
const categories = sidebarCategoriesOrder.map(name => ({ name, count: categoryMap[name] || 0 }));

// 3. 處理年份 > 月份動態統計
const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const yearlyStatsMap = {};

allProjects.forEach(p => {
    const dateParts = p.data.date.split('.');
    const year = dateParts[0];
    const monthIndex = parseInt(dateParts[1]) - 1 || 0;
    const monthName = monthNames[monthIndex];
    if (!yearlyStatsMap[year]) yearlyStatsMap[year] = {};
    yearlyStatsMap[year][monthName] = (yearlyStatsMap[year][monthName] || 0) + 1;
});

const sortedYearlyStats = Object.entries(yearlyStatsMap)
    .sort((a, b) => b[0].localeCompare(a[0]))
    .map(([year, months]) => ({
        year,
        months: Object.entries(months).sort((a, b) => monthNames.indexOf(b[0]) - monthNames.indexOf(a[0]))
    }));

// 4. 排序專案 (最新在前)
const sortedProjects = allProjects.sort((a, b) => b.data.date.localeCompare(a.data.date));

---

<div data-projects-root data-period-root class="grid grid-cols-1 max-lg:grid-rows-[minmax(0,1fr)] lg:grid-cols-[1fr_280px] h-full lg:h-[calc(100vh-80px)] lg:divide-x divide-white/10 overflow-hidden bg-transparent">
    
    <main class="flex flex-col h-full min-h-0 overflow-y-auto overscroll-contain drag-scrollbar bg-transparent">
        <div class="p-5 sm:p-8 md:p-12 flex-1">
            <h2 class="text-3xl lg:text-4xl font-extrabold mb-6 lg:mb-12 tracking-tight text-white">Projects</h2>
            <FeaturedMarquee />
            <div class="space-y-5 md:space-y-8" id="project-list-container">
                {withMilestones(sortedProjects, p => p.data.date).map(entry => (
                    entry.type === 'milestone'
                        ? <ProjectMilestone milestone={entry.milestone} />
                        : <ProjectCard project={entry.item} />
                ))}
            </div>
            <div class="h-8 lg:h-20"></div>
        </div>

        <GlobalFooter />
    </main>

    <MobileDrawer class="lg:p-8 overflow-y-auto hide-scrollbar" menuTitle="篩選" showApply>
        <ProjectSidebar tags={sortedTags} yearlyStats={sortedYearlyStats} categories={categories} dates={sortedProjects.map(p => p.data.date)} />
        <div class="h-4 lg:h-20"></div>
    </MobileDrawer>
</div>

<style>
    .hide-scrollbar::-webkit-scrollbar { display: none; }
</style>

<script>
    function initProjectFilters(root: Element) {
        const tagButtons = root.querySelectorAll('.tag-button');
        const categoryItems = root.querySelectorAll('.filter-category');
        const monthButtons = root.querySelectorAll('.month-filter-btn');
        const projectCards = root.querySelectorAll('.project-card');
        const clearBtn = root.querySelector('.clear-all-filters');
        const toggleBtn = root.querySelector('.toggle-tags-btn');
        const moreTags = root.querySelectorAll('.more-tag');

        let activeCategory = null;
        let activeTag = null;
        let activeMonth = null;

        function applyFilters() {
            const hasFilter = activeCategory !== null || activeTag !== null || activeMonth !== null;
        
            // 1. 處理卡片顯示/隱藏
            projectCards.forEach(card => {
                const cardCategory = card.getAttribute('data-category');
                const cardTags = JSON.parse(card.getAttribute('data-tags') || '[]');
                const cardDate = card.getAttribute('data-date');
            
                const matchCategory = !activeCategory || cardCategory === activeCategory;
                const matchTag = !activeTag || cardTags.includes(activeTag);
                const matchMonth = !activeMonth || (cardDate && cardDate.startsWith(activeMonth));

                (card as HTMLElement).style.display = (matchCategory && matchTag && matchMonth) ? 'block' : 'none';
            });

            // 2. --- 核心修改：處理全頁面標籤按鈕的高亮 (連動特效) ---
            const allTagButtons = root.querySelectorAll('.tag-button');
            allTagButtons.forEach(btn => {
                const tagName = btn.getAttribute('data-tag-name');
                const isMatch = tagName === activeTag;

                btn.classList.toggle('filter-active', isMatch);
            });

            // 階段分隔線（進入大學 / 進入高中）在標籤、類型、月份篩選時一律保留，不做隱藏

            if (hasFilter) clearBtn?.classList.remove('hidden');
            else clearBtn?.classList.add('hidden');
        }

        // --- 類型點擊邏輯 ---
        categoryItems.forEach(item => {
            item.addEventListener('click', () => {
                const cat = item.getAttribute('data-category');
                if (activeCategory === cat) activeCategory = null;
                else {
                    categoryItems.forEach(i => i.classList.remove('filter-active'));
                    activeCategory = cat;
                }
                item.classList.toggle('filter-active', activeCategory === cat);
                applyFilters();
            });
        });

        // --- 標籤點擊邏輯 ---
        tagButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                const tag = btn.getAttribute('data-tag-name');
                activeTag = (activeTag === tag) ? null : tag;
                applyFilters();
            });
        });

        // --- 月份點擊邏輯 ---
        monthButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                const monYear = btn.getAttribute('data-month-year');
                if (activeMonth === monYear) activeMonth = null;
                else {
                    monthButtons.forEach(b => b.classList.remove('filter-active'));
                    activeMonth = monYear;
                }
                btn.classList.toggle('filter-active', activeMonth === monYear);
                applyFilters();
            });
        });

        // --- 重置所有過濾 ---
        clearBtn?.addEventListener('click', () => {
            activeCategory = null; activeTag = null; activeMonth = null;
            categoryItems.forEach(i => i.classList.remove('filter-active'));
            monthButtons.forEach(b => b.classList.remove('filter-active'));
            applyFilters();
        });

        // --- 顯示更多標籤 ---
        toggleBtn?.addEventListener('click', () => {
            const isExpanded = toggleBtn.textContent?.includes('較少');
            moreTags.forEach(t => t.classList.toggle('hidden'));
            toggleBtn.textContent = isExpanded ? `顯示更多 (${moreTags.length})` : '顯示較少';
        });
    }

    document.querySelectorAll('[data-projects-root]').forEach(initProjectFilters);
</script>