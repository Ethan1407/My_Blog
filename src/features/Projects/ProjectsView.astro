---
import { getCollection } from 'astro:content';
import ProjectCard from './components/ProjectCard.astro';
import ProjectSidebar from './components/ProjectSidebar.astro';

// 1. 抓取所有專案
const allProjects = await getCollection('projects');

// 2. 處理標籤邏輯
const tagMap = {};
allProjects.forEach(p => {
    p.data.tags.forEach(t => {
        tagMap[t] = (tagMap[t] || 0) + 1;
    });
});
const sortedTags = Object.entries(tagMap)
    .map(([name, count]) => ({ name, count }))
    .sort((a, b) => b.count - a.count);

// 3. 處理年份 > 月份動態統計
const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const yearlyStatsMap = {};

allProjects.forEach(p => {
    const dateParts = p.data.date.split('.');
    const year = dateParts[0];
    const monthIndex = parseInt(dateParts[1]) - 1 || 0;
    const monthName = monthNames[monthIndex];
    if (!yearlyStatsMap[year]) yearlyStatsMap[year] = {};
    yearlyStatsMap[year][monthName] = (yearlyStatsMap[year][monthName] || 0) + 1;
});

const sortedYearlyStats = Object.entries(yearlyStatsMap)
    .sort((a, b) => b[0].localeCompare(a[0]))
    .map(([year, months]) => ({
        year,
        months: Object.entries(months).sort((a, b) => monthNames.indexOf(b[0]) - monthNames.indexOf(a[0]))
    }));

// 4. 排序專案 (最新在前)
const sortedProjects = allProjects.sort((a, b) => b.data.date.localeCompare(a.data.date));

/**
 * 5. 自動抓取 GitHub 最新 Commit 時間
 */
let lastUpdated = "2026.02.15"; 
try {
  const username = "Ethan1407";
  const repo = "My_Blog"; 
  const response = await fetch(`https://api.github.com/repos/${username}/${repo}/commits?per_page=1`, {
    headers: { 'User-Agent': 'Astro-App' }
  });
  if (response.ok) {
    const commits = await response.json();
    if (commits.length > 0) {
      const date = new Date(commits[0].commit.committer.date);
      lastUpdated = date.toLocaleDateString('zh-TW', {
        year: 'numeric', month: '2-digit', day: '2-digit',
      }).replace(/\//g, '.');
    }
  }
} catch (e) { console.error("GitHub API Error:", e); }
---

