---
// src/features/Home/HomeViewMobile.astro
// 手機版首頁 - 簡化設計，一次展示一個重點
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import astronautImg from './astronaut.webp';

const projectEntries = await getCollection('projects');
const latestPost = projectEntries.sort((a, b) => {
    return new Date(b.data.date.replace(/\./g, '-')).getTime() - new Date(a.data.date.replace(/\./g, '-')).getTime();
})[0];
---

<section class="md:hidden relative min-h-[calc(100vh-80px)] flex flex-col items-center justify-center pt-10 pb-12 px-4 bg-transparent overflow-hidden">
    
    <!-- 標題 -->
    <div class="z-10 text-center mb-8">
        <h1 class="text-4xl font-black tracking-tighter text-white">
            I'M <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-600 drop-shadow-[0_0_15px_rgba(59,130,246,0.3)]">ETHAN</span>
        </h1>
    </div>

    <!-- 太空人圖片 - 手機版縮小 -->
    <div class="relative z-10 w-64 mb-10">
        <Image 
            src={astronautImg} 
            alt="Floating Astronaut" 
            class="w-full h-auto drop-shadow-[0_0_30px_rgba(59,130,246,0.2)]"
        />
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] bg-blue-600/10 rounded-full blur-[100px] -z-10"></div>
    </div>

    <!-- 最新專案 -->
    {latestPost && (
        <a 
            href={`/projects/${latestPost.slug}`}
            class="group z-10 flex flex-col items-start gap-2 w-full px-4 py-3 rounded-lg bg-white/5 backdrop-blur-md border border-white/10 hover:bg-white/10 hover:border-blue-400/50 transition-all duration-300 active:scale-95 shadow-lg shadow-blue-900/10"
        >
            <span class="flex items-center gap-2">
                <span class="flex h-2 w-2 rounded-full bg-blue-400 animate-pulse"></span>
                <span class="text-gray-400 text-xs font-medium tracking-wider uppercase">Latest Post</span>
            </span>
            <span class="text-white font-semibold text-sm truncate w-full">
                {latestPost.data.title}
            </span>
        </a>
    )}

    <!-- 快速導航 -->
    <div class="z-10 w-full mt-8 space-y-2">
        <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider px-2">Quick Access</p>
        <div class="grid grid-cols-3 gap-2">
            <a 
                href="/about"
                class="flex flex-col items-center gap-2 px-3 py-4 rounded-lg bg-white/5 border border-white/10 hover:bg-white/10 transition-colors"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                <span class="text-xs font-medium text-white">About</span>
            </a>
            <a 
                href="/projects"
                class="flex flex-col items-center gap-2 px-3 py-4 rounded-lg bg-white/5 border border-white/10 hover:bg-white/10 transition-colors"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="9" x2="15" y2="9"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
                <span class="text-xs font-medium text-white">Projects</span>
            </a>
            <a 
                href="/hobbies"
                class="flex flex-col items-center gap-2 px-3 py-4 rounded-lg bg-white/5 border border-white/10 hover:bg-white/10 transition-colors"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                <span class="text-xs font-medium text-white">Hobbies</span>
            </a>
        </div>
    </div>

</section>
