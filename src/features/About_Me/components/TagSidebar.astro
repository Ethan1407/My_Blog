---
/**
 * TagSidebar 組件 (About Me 版本)
 */
import PeriodFilter from '@/components/PeriodFilter.astro';
const { tags = [], categories = [], dates = [], monthDates = [] } = Astro.props;
// 動態：年份 > 月份統計（與 Projects 頁 ProjectSidebar 相同的呈現方式）
const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const yearlyStatsMap = {};
monthDates.forEach(d => {
    const [year, mon] = String(d).split('-')[0].split('.');
    const monthName = monthNames[(parseInt(mon) - 1) || 0];
    if (!yearlyStatsMap[year]) yearlyStatsMap[year] = {};
    yearlyStatsMap[year][monthName] = (yearlyStatsMap[year][monthName] || 0) + 1;
});
const yearlyStats = Object.entries(yearlyStatsMap)
    .sort((a, b) => b[0].localeCompare(a[0]))
    .map(([year, months]) => ({
        year,
        months: Object.entries(months).sort((a, b) => monthNames.indexOf(b[0]) - monthNames.indexOf(a[0]))
    }));
const otherTags = tags.slice(8);
---
<div class="space-y-12">
    <section>
        <h2 class="text-lg font-bold mb-4 tracking-widest border-l-4 border-white pl-3 text-white uppercase text-[15px]">類型</h2>
        <ul class="space-y-0.5 text-base text-gray-300">
            {categories.map(cat => (
                <li 
                    class="filter-category flex items-center justify-between hover:text-white cursor-pointer transition-colors group px-2 py-1 rounded-md" 
                    data-category={cat.name}
                >
                    <span class="flex items-center">
                        <span class="mr-2 text-white/30 group-hover:text-white text-xs">•</span> {cat.name}
                    </span>
                    <span class="text-[11px] font-mono text-white/40 group-hover:text-white/80">{cat.count}</span>
                </li>
            ))}
        </ul>
    </section>

    <PeriodFilter dates={dates} />

    <section>
        <h2 class="text-lg font-bold mb-4 tracking-widest border-l-4 border-white pl-3 text-white uppercase text-[15px]">標籤</h2>
        
        <div class="flex flex-col items-start gap-2">
            {tags.map((tag, index) => (
                <button 
                    class={`tag-button ${index >= 8 ? 'hidden more-tag' : ''} bg-[#5a5a5a]/60 hover:bg-white hover:text-[#424242] py-2 px-4 rounded-md text-sm font-bold transition-all flex items-center justify-between border border-white/5 group shadow-sm text-white w-full`}
                    data-tag-name={tag.name}
                >
                    <span class="tracking-wide">{tag.name}</span>
                    <span class="bg-white/10 group-hover:bg-[#424242]/10 px-1.5 py-0.5 rounded text-[10px] font-bold text-white/60 group-hover:text-[#424242] min-w-[24px] text-center transition-colors">
                        {tag.count}
                    </span>
                </button>
            ))}

            {otherTags.length > 0 && (
                <button class="toggle-tags-btn mt-2 text-[11px] font-bold text-gray-500 hover:text-white transition-colors text-left pl-2">
                    顯示更多 ({otherTags.length})
                </button>
            )}
            
            <button class="clear-all-filters hidden mt-2 text-[11px] font-bold text-blue-400 hover:text-blue-300 transition-colors text-left pl-1 uppercase tracking-tighter">
                ✕ 重置所有過濾
            </button>
        </div>
    </section>

    <section>
        <h2 class="text-lg font-bold mb-4 tracking-widest border-l-4 border-white pl-3 text-white uppercase text-[15px]">動態</h2>
        <div class="space-y-5">
            {yearlyStats.map((yearGroup) => (
                <div>
                    <h3 class="text-base font-bold text-white mb-2 flex items-center gap-2">
                        <div class="w-1 h-1 bg-blue-400 rounded-full shadow-[0_0_8px_rgba(96,165,250,0.8)]"></div>
                        {yearGroup.year}
                    </h3>
                    <div class="space-y-0.5 ml-3 border-l border-white/10 pl-3">
                        {yearGroup.months.map(([month, count]) => (
                            <button
                                class="month-filter-btn flex justify-between items-center w-full text-gray-400 text-[13px] hover:text-white transition-all py-0.5 px-2 rounded hover:bg-white/5 group text-left"
                                data-month-year={`${yearGroup.year}.${String(monthNames.indexOf(month) + 1).padStart(2, '0')}`}
                            >
                                <span>{month}</span>
                                <span class="font-mono text-white/40 group-hover:text-white/80 text-xs">{count}</span>
                            </button>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </section>
</div>