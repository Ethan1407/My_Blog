---
/**
 * TagSidebar 組件 (About Me 版本)
 */
const { tags = [], years = [], categories = [] } = Astro.props;
const topTags = tags.slice(0, 8); 
const otherTags = tags.slice(8);
---
<div class="space-y-12">
    <section>
        <h2 class="text-lg font-bold mb-4 tracking-widest border-l-4 border-white pl-3 text-white uppercase text-[15px]">類型</h2>
        <ul class="space-y-0.5 text-base text-gray-300">
            {categories.map(cat => (
                <li 
                    class="filter-category flex items-center justify-between hover:text-white cursor-pointer transition-colors group px-2 py-1 rounded-md" 
                    data-category={cat.name}
                >
                    <span class="flex items-center">
                        <span class="mr-2 text-white/30 group-hover:text-white text-xs">•</span> {cat.name}
                    </span>
                    <span class="text-[11px] font-mono text-white/40 group-hover:text-white/80">{cat.count}</span>
                </li>
            ))}
        </ul>
    </section>

    <section>
        <h2 class="text-lg font-bold mb-4 tracking-widest border-l-4 border-white pl-3 text-white uppercase text-[15px]">標籤</h2>
        
        <div class="flex flex-col items-start gap-2">
            {tags.map((tag, index) => (
                <button 
                    class={`tag-button ${index >= 8 ? 'hidden more-tag' : ''} bg-[#5a5a5a]/60 hover:bg-white hover:text-[#424242] py-2 px-4 rounded-md text-sm font-bold transition-all flex items-center justify-between border border-white/5 group shadow-sm text-white w-full`}
                    data-tag-name={tag.name}
                >
                    <span class="tracking-wide">{tag.name}</span>
                    <span class="bg-white/10 group-hover:bg-[#424242]/10 px-1.5 py-0.5 rounded text-[10px] font-bold text-white/60 group-hover:text-[#424242] min-w-[24px] text-center transition-colors">
                        {tag.count}
                    </span>
                </button>
            ))}

            {otherTags.length > 0 && (
                <button id="toggle-tags-btn" class="mt-2 text-[11px] font-bold text-gray-500 hover:text-white transition-colors text-left pl-2">
                    顯示更多 ({otherTags.length})
                </button>
            )}
            
            <button id="clear-all-filters" class="hidden mt-2 text-[11px] font-bold text-blue-400 hover:text-blue-300 transition-colors text-left pl-1 uppercase tracking-tighter">
                ✕ 重置所有過濾
            </button>
        </div>
    </section>

    <section>
        <h2 class="text-lg font-bold mb-4 tracking-widest border-l-4 border-white pl-3 text-white uppercase text-[15px]">動態</h2>
        <div class="flex flex-col items-start gap-2">
            {years.map(year => (
                <button 
                    class="year-filter-btn bg-[#5a5a5a]/60 hover:bg-white hover:text-[#424242] py-2 px-4 rounded-md text-sm font-bold transition-all flex items-center justify-between border border-white/5 group shadow-sm text-white w-full"
                    data-year={year}
                >
                    <span class="tracking-wide">{year}</span>
                    <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span>
                </button>
            ))}
        </div>
    </section>
</div>