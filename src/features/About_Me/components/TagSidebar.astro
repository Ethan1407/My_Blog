---
/**
 * TagSidebar 組件 (About Me 版本)
 * 1. 數量優化：初始顯示前 8 個標籤，其餘隱藏。
 * 2. 排版：絕對左對齊 (items-start)，與 Projects 設計同步。
 * 3. 樣式：瘦長長方形，支援 Active 狀態。
 */
const { tags = [] } = Astro.props;
const topTags = tags.slice(0, 8); // 修改為顯示前 8 個
const otherTags = tags.slice(8);
---
<div class="space-y-8">
    <section>
        <h2 class="text-lg font-bold mb-4 tracking-widest border-l-4 border-white pl-3 text-white uppercase">標籤</h2>
        
        <div class="flex flex-col items-start gap-2">
            {tags.map((tag, index) => (
                <button 
                    class={`tag-button ${index >= 8 ? 'hidden more-tag' : ''} bg-[#5a5a5a]/60 hover:bg-white hover:text-[#424242] py-1 px-3.5 rounded-md text-sm font-bold transition-all flex items-center justify-between border border-white/5 group shadow-sm text-white w-full`}
                    data-tag-name={tag.name}
                >
                    <span class="tracking-wide">{tag.name}</span>
                    <span class="bg-white/10 group-hover:bg-[#424242]/10 px-1.5 py-0.5 rounded text-[10px] font-bold text-white/60 group-hover:text-[#424242] min-w-[24px] text-center transition-colors">
                        {tag.count}
                    </span>
                </button>
            ))}

            {otherTags.length > 0 && (
                <button id="toggle-tags-btn" class="mt-2 text-[11px] font-bold text-gray-500 hover:text-white transition-colors text-left pl-2">
                    顯示更多 ({otherTags.length})
                </button>
            )}
            
            <button id="clear-all-filters" class="hidden mt-2 text-[11px] font-bold text-blue-400 hover:text-blue-300 transition-colors text-left pl-1 uppercase tracking-tighter">
                ✕ 重置所有過濾
            </button>
        </div>
    </section>
</div>