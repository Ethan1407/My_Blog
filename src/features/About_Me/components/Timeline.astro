---
/**
 * Timeline 組件：自動適應 Markdown Frontmatter 格式
 */
const { events = [] } = Astro.props;

// 1. 自動排序日期：最新的在最上面
const sortedEvents = [...events].sort((a, b) => {
  const dateA = new Date(a.date.replace(/\./g, '-')).getTime();
  const dateB = new Date(b.date.replace(/\./g, '-')).getTime();
  return dateB - dateA;
});
---

<div class="relative">
  <h2 class="text-3xl font-bold mb-16 tracking-widest text-white">Timeline</h2>

  <div class="absolute left-[10.5rem] top-24 bottom-10 w-[2px] bg-white hidden md:block opacity-50"></div>

  <div class="space-y-16 relative">
    <div class="flex items-center mb-20 relative h-8">
      <div class="w-40 text-right pr-8 font-bold text-xl text-gray-400">Present</div>
      <div class="absolute left-[10.5rem] -translate-x-1/2 w-6 h-6 bg-white rounded-full z-10 ring-4 ring-[#424242]"></div>
      <div class="pl-12 font-bold text-2xl tracking-widest text-white">Now</div>
    </div>

    {sortedEvents.map((item, index) => {
      // 直接從 Frontmatter 取得資料
      const tags = item.tags || [];
      const tagsString = JSON.stringify(tags);

      // 年度邏輯
      const currentYear = item.date.split('.')[0];
      const nextYear = sortedEvents[index + 1] ? sortedEvents[index + 1].date.split('.')[0] : null;
      const isYearEnd = currentYear !== nextYear;

      // 整理要顯示的細節內容
      const displayDetails = [
        { label: 'location', value: item.location },
        { label: 'category', value: item.category },
        { label: 'content', value: item.content },
      ];

      return (
        <Fragment key={index}>
          {/* 事件節點 */}
          <div class="timeline-event flex items-start group relative" data-tags={tagsString}>
            <div class="w-40 text-right pr-8 pt-1 font-bold text-lg tracking-wider text-gray-300">
              {item.date}
            </div>

            <div class="absolute left-[10.5rem] -translate-x-1/2 w-4 h-4 bg-white rounded-full z-10 mt-2 ring-4 ring-[#424242] group-hover:scale-125 transition-all"></div>

            <div class="flex-1 pl-12">
              <h3 class="text-2xl font-bold mb-4 tracking-wide text-white underline underline-offset-8 decoration-white/20 group-hover:decoration-white transition-all">
                {item.title}
              </h3>
              
              <ul class="space-y-3 text-gray-300 text-lg leading-relaxed">
                {/* 顯示 Location, Category, Content */}
                {displayDetails.map((detail) => detail.value && (
                  <li class="flex items-start">
                    <span class="font-semibold min-w-[120px] text-white/80">• {detail.label} :</span>
                    <span class="flex-1 text-gray-400">{detail.value}</span>
                  </li>
                ))}

                {/* 顯示 Tags (藍色按鈕) */}
                {tags.length > 0 && (
                  <li class="flex items-start">
                    <span class="font-semibold min-w-[120px] text-white/80">• label :</span>
                    <div class="flex flex-wrap gap-2 flex-1">
                      {tags.map((tag) => (
                        <button 
                            class="tag-button text-sm text-blue-300/80 bg-blue-400/10 hover:bg-white hover:text-[#424242] px-2 py-0.5 rounded-md border border-blue-400/20 transition-all font-bold"
                            data-tag-name={tag}
                        >
                            {tag}
                        </button>
                      ))}
                    </div>
                  </li>
                )}
              </ul>
              
              {/* 如果有圖片，可以選擇性顯示 */}
              {item.image && (
                <div class="mt-6 overflow-hidden rounded-lg opacity-80 group-hover:opacity-100 transition-opacity">
                   <img src={item.image} alt={item.title} class="w-72 h-auto object-cover border border-white/10" />
                </div>
              )}
            </div>
          </div>

          {/* 年度分界線 */}
          {isYearEnd && (
            <div class="flex items-center my-20 relative h-10">
              <div class="w-40 text-right pr-8 font-bold text-3xl text-gray-400">{currentYear}</div>
              <div class="absolute left-[10.5rem] -translate-x-1/2 w-10 h-[2px] bg-white z-10 opacity-80"></div>
            </div>
          )}
        </Fragment>
      );
    })}
  </div>

  <div class="h-40"></div>
</div>