---
/**
 * Timeline 組件：標題支援超連結，並根據是否有連結動態切換滑鼠特效
 */
const { events = [] } = Astro.props;

// 1. 自動排序日期
const sortedEvents = [...events].sort((a, b) => {
  const dateAStr = a.data?.date || "0000.00.00";
  const dateBStr = b.data?.date || "0000.00.00";
  
  const dateA = new Date(dateAStr.replace(/\./g, '-')).getTime();
  const dateB = new Date(dateBStr.replace(/\./g, '-')).getTime();
  return dateB - dateA;
});
---

<div class="relative">
  <h2 class="text-3xl font-bold mb-16 tracking-widest text-white">Timeline</h2>

  <div class="absolute left-[10.5rem] top-24 bottom-10 w-[2px] bg-white hidden md:block opacity-50 z-0"></div>

  <div class="space-y-16 relative">
    <div class="flex items-center mb-20 relative h-8">
      <div class="w-[10.5rem] text-right pr-8 font-bold text-xl text-gray-400 flex-shrink-0 whitespace-nowrap">
        Present
      </div>
      <div class="absolute left-[10.5rem] -translate-x-1/2 w-6 h-6 bg-white rounded-full z-10 ring-4 ring-[#424242]"></div>
      <div class="pl-12 font-bold text-2xl tracking-widest text-white">
        Now
      </div>
    </div>

    {sortedEvents.map((item, index) => {
      const { 
        title, date, location, category, summary, tags = [] 
      } = item.data;

      const tagsString = JSON.stringify(tags);

      // --- 判斷連結路徑 ---
      const isProject = item.collection === 'projects';
      const projectPath = isProject ? `/projects/${item.slug}` : null;

      // 提取開始日期（處理範圍日期如 2024.07.08-12）
      const startDate = date.split('-')[0]; // "2024.07.08"
      const currentYear = startDate.split('.')[0]; // "2024"
      const nextItemDate = sortedEvents[index + 1] ? sortedEvents[index + 1].data.date : null;
      const nextItemStartDate = nextItemDate ? nextItemDate.split('-')[0] : null;
      const nextYear = nextItemStartDate ? nextItemStartDate.split('.')[0] : null;
      const isYearEnd = currentYear !== nextYear;

      const displayDetails = [
        { label: 'location', value: location },
        { label: 'category', value: category },
        { label: 'summary', value: summary }, 
      ];

      return (
        <Fragment key={index}>
          <div class="timeline-event flex items-start group relative" data-tags={tagsString} data-category={category}>
            <div class="w-[10.5rem] text-right pr-8 pt-1 font-bold text-lg tracking-wider text-gray-300 flex-shrink-0 whitespace-nowrap">
              {date}
            </div>

            {/* 圓點特效：只有在 projectPath 存在時才加上 group-hover:scale-125 */}
            <div class={`absolute left-[10.5rem] -translate-x-1/2 w-4 h-4 bg-white rounded-full z-10 mt-2 ring-4 ring-[#424242] transition-all duration-300 ${projectPath ? 'group-hover:scale-125' : ''}`}></div>

            <div class="flex-1 pl-12">
              {/* 標題特效控制 */}
              <h3 class={`text-2xl font-bold mb-4 tracking-wide text-white transition-all duration-300 ${projectPath ? 'underline underline-offset-8 decoration-white/20 group-hover:decoration-white' : ''}`}>
                {projectPath ? (
                  <a href={projectPath} class="hover:text-blue-400 hover:translate-x-1 transition-all inline-flex items-center gap-2">
                    {title}
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-50 group-hover:opacity-100 transition-opacity"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                  </a>
                ) : (
                  title
                )}
              </h3>
              
              <ul class="space-y-3 text-gray-300 text-lg leading-relaxed">
                {displayDetails.map((detail) => detail.value && (
                  <li class="flex items-start">
                    <span class="font-semibold min-w-[120px] text-white/80">• {detail.label} :</span>
                    <span class="flex-1 text-gray-400">{detail.value}</span>
                  </li>
                ))}

                {tags.length > 0 && (
                  <li class="flex items-start">
                    <span class="font-semibold min-w-[120px] text-white/80">• tags :</span>
                    <div class="flex flex-wrap gap-2 flex-1">
                      {tags.map((tag) => (
                        <button 
                            class="tag-button text-sm text-blue-300/80 bg-blue-400/10 hover:bg-white hover:text-[#424242] px-2 py-0.5 rounded-md border border-blue-400/20 transition-all font-bold"
                            data-tag-name={tag}
                        >
                            {tag}
                        </button>
                      ))}
                    </div>
                  </li>
                )}
              </ul>
            </div>
          </div>

          {isYearEnd && (
            <div class="flex items-center my-20 relative h-10">
              <div class="w-[10.5rem] text-right pr-8 font-bold text-3xl text-gray-400">{currentYear}</div>
              <div class="absolute left-[10.5rem] -translate-x-1/2 w-10 h-[2px] bg-white z-10 opacity-80"></div>
            </div>
          )}
        </Fragment>
      );
    })}
  </div>

  <div class="h-40"></div>
</div>