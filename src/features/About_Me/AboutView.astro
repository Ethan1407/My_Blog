<style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.3); border-radius: 10px; }
    .hide-scrollbar::-webkit-scrollbar { display: none; }
</style>

<script>
    const eventItems = document.querySelectorAll('.timeline-event'); 
    const tagButtons = document.querySelectorAll('.tag-button');
    const yearButtons = document.querySelectorAll('.year-filter-btn');
    const clearBtn = document.getElementById('clear-all-filters');
    const toggleBtn = document.getElementById('toggle-tags-btn');
    const moreTags = document.querySelectorAll('.more-tag');

    let activeTag = null;
    let activeYear = null;

    function applyFilter() {
        eventItems.forEach(item => {
            const itemTags = JSON.parse(item.getAttribute('data-tags') || '[]');
            const itemDate = (item.querySelector('.w-40')?.textContent || "").trim();
            const itemYear = itemDate.split('.')[0];

            const matchTag = !activeTag || itemTags.includes(activeTag);
            const matchYear = !activeYear || itemYear === activeYear;

            (item as HTMLElement).style.display = (matchTag && matchYear) ? '' : 'none';
        });

        tagButtons.forEach(btn => {
            const isMatch = btn.getAttribute('data-tag-name') === activeTag;
            
            btn.classList.toggle('bg-white', isMatch);
            // 🟢 強制改為 text-black
            btn.classList.toggle('text-black', isMatch); 
            btn.classList.toggle('font-bold', isMatch);
            
            if (!isMatch) {
                btn.classList.add('text-gray-300');
                btn.classList.remove('text-black');
            } else {
                btn.classList.remove('text-gray-300');
            }

            btn.classList.toggle('ring-2', isMatch);
            btn.classList.toggle('ring-blue-400', isMatch);
        });

        yearButtons.forEach(btn => {
            const isMatch = btn.getAttribute('data-year') === activeYear;
            
            btn.classList.toggle('bg-white', isMatch);
            // 🟢 同樣強制改為 text-black
            btn.classList.toggle('text-black', isMatch);
            btn.classList.toggle('font-bold', isMatch);

            if (!isMatch) {
                btn.classList.add('text-gray-300');
                btn.classList.remove('text-black');
            } else {
                btn.classList.remove('text-gray-300');
            }

            btn.classList.toggle('ring-2', isMatch);
            btn.classList.toggle('ring-blue-400', isMatch);
        });

        if (activeTag || activeYear) clearBtn?.classList.remove('hidden');
        else clearBtn?.classList.add('hidden');
    }

    tagButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            const tagName = btn.getAttribute('data-tag-name');
            activeTag = (activeTag === tagName) ? null : tagName;
            applyFilter();
        });
    });

    yearButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            const year = btn.getAttribute('data-year');
            activeYear = (activeYear === year) ? null : year;
            applyFilter();
        });
    });

    toggleBtn?.addEventListener('click', () => {
        const isHidden = moreTags[0].classList.contains('hidden');
        moreTags.forEach(t => t.classList.toggle('hidden'));
        toggleBtn.textContent = isHidden ? '顯示較少' : `顯示更多 (${moreTags.length})`;
    });

    clearBtn?.addEventListener('click', () => { 
        activeTag = null; 
        activeYear = null; 
        applyFilter(); 
    });
</script>