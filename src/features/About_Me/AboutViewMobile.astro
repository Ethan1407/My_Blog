---
// src/features/About_Me/AboutViewMobile.astro
// 手機版 About - 使用桌面版設計，透過按鈕切換區塊
import { getCollection } from 'astro:content';
import ProfileSidebar from './components/ProfileSidebar.astro';
import Timeline from './components/Timeline.astro';
import TagSidebar from './components/TagSidebar.astro';
import experienceData from '../../data/experience.json';

// 1. 僅抓取 Projects MD 資料
const projectEntries = await getCollection('projects');

// 2. 處理資料合併與去重
const seenTitles = new Set();
const allEntries = [];

projectEntries.forEach(entry => {
    seenTitles.add(entry.data.title);
    allEntries.push(entry);
});

experienceData.forEach(item => {
    if (!seenTitles.has(item.title)) {
        allEntries.push({
            collection: 'experience_json',
            slug: '',
            data: { ...item }
        });
    }
});

// 3. 排序邏輯 (處理範圍日期，如 2024.07.08-12)
const sortedEvents = allEntries.sort((a, b) => {
  const dateAStart = a.data.date.split('-')[0];
  const dateBStart = b.data.date.split('-')[0];
  
  const dateA = new Date(dateAStart.replace(/\./g, '-')).getTime();
  const dateB = new Date(dateBStart.replace(/\./g, '-')).getTime();
  return dateB - dateA;
});

// 4. 提取不重複年份 (需要處理範圍日期)
const years = [...new Set(sortedEvents.map(e => e.data.date.split('-')[0].split('.')[0]))].sort((a, b) => b.localeCompare(a));

// 5. 標籀計數
const tagCountMap = {};
sortedEvents.forEach(entry => {
  const tags = entry.data.tags || [];
  tags.forEach(tag => {
    tagCountMap[tag] = (tagCountMap[tag] || 0) + 1;
  });
});

const sortedTags = Object.entries(tagCountMap)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);

// 6. 類別計數
const categoryCountMap = {};
sortedEvents.forEach(entry => {
  const category = entry.data.category || '';
  if (category) {
    categoryCountMap[category] = (categoryCountMap[category] || 0) + 1;
  }
});

const sortedCategories = Object.entries(categoryCountMap)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);

/**
 * 自動抓取 GitHub 最新 Commit 時間
 */
let lastUpdated = 2026.02.15; 
try {
  const response = await fetch(https://api.github.com/repos/Ethan1407/My_Blog/commits?per_page=1, {
    headers: { 'User-Agent': 'Astro-App' }
  });
  if (response.ok) {
    const commits = await response.json();
    if (commits.length > 0) {
      const date = new Date(commits[0].commit.committer.date);
      lastUpdated = date.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '.');
    }
  }
} catch (e) { console.error(e); }
---

<!-- 手機版容器 - 垂直堆疊佈局 -->
<div class=md:hidden flex flex-col h-[calc(100vh-80px)] bg-transparent>
    
    <!-- 頂部切換按鈕 -->
    <div class=sticky top-0 z-40 px-4 py-3 bg-[#050b1a]/80 backdrop-blur border-b border-white/10 flex gap-2>
        <button id=tab-timeline class=tab-switch flex-1 px-3 py-2 rounded text-sm font-semibold bg-white/20 text-white border border-white/20 transition-all>
            Timeline
        </button>
        <button id=tab-tags class=tab-switch flex-1 px-3 py-2 rounded text-sm font-semibold bg-white/5 text-gray-400 border border-white/10 transition-all hover:text-white>
            Tags & Categories
        </button>
    </div>

    <!-- 主內容區 - 可滾動 -->
    <div class=flex-1 overflow-y-auto custom-scrollbar>
        
        <!-- 時間軸內容 -->
        <div id=timeline-section class=p-4 space-y-4>
            <h2 class=text-2xl font-extrabold mb-4 tracking-tight text-white>About Me</h2>
            {sortedEvents.length > 0 ? (
                <Timeline events={sortedEvents} />
            ) : (
                <div class=text-white text-center p-20 border-2 border-dashed border-gray-500 bg-transparent>
                    <p class=text-xl>目前沒有資料，請確認資料夾或 JSON 內容。</p>
                </div>
            )}
            <div class=h-20></div>
        </div>

        <!-- 標籤和類別側邊欄內容 -->
        <div id=tags-section class=hidden p-4>
            <h2 class=text-2xl font-extrabold mb-6 tracking-tight text-white>Filters</h2>
            <TagSidebar tags={sortedTags} years={years} categories={sortedCategories} />
            <div class=h-20></div>
        </div>

    </div>

    <!-- 頁腳 -->
    <footer class=w-full py-6 px-4 border-t border-white/10 bg-[#050b1a]/80 backdrop-blur text-xs>
        <div class=flex justify-between items-center>
            <div class=text-gray-400 font-mono tracking-widest uppercase>
                Last Updated : <span class=text-white font-bold>{lastUpdated}</span>
            </div>
        </div>
    </footer>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.3); border-radius: 10px; }
</style>

<script>
    const tabTimeline = document.getElementById('tab-timeline');
    const tabTags = document.getElementById('tab-tags');
    const timelineSection = document.getElementById('timeline-section');
    const tagsSection = document.getElementById('tags-section');

    function switchTab(tabName) {
        if (tabName === 'timeline') {
            timelineSection?.classList.remove('hidden');
            tagsSection?.classList.add('hidden');
            tabTimeline?.classList.add('bg-white/20', 'text-white', 'border-white/20');
            tabTimeline?.classList.remove('bg-white/5', 'text-gray-400', 'border-white/10');
            tabTags?.classList.remove('bg-white/20', 'text-white', 'border-white/20');
            tabTags?.classList.add('bg-white/5', 'text-gray-400', 'border-white/10');
        } else if (tabName === 'tags') {
            tagsSection?.classList.remove('hidden');
            timelineSection?.classList.add('hidden');
            tabTags?.classList.add('bg-white/20', 'text-white', 'border-white/20');
            tabTags?.classList.remove('bg-white/5', 'text-gray-400', 'border-white/10');
            tabTimeline?.classList.remove('bg-white/20', 'text-white', 'border-white/20');
            tabTimeline?.classList.add('bg-white/5', 'text-gray-400', 'border-white/10');
        }
    }

    tabTimeline?.addEventListener('click', () => switchTab('timeline'));
    tabTags?.addEventListener('click', () => switchTab('tags'));
</script>
