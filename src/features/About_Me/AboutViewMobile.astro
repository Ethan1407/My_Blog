---
import { getCollection } from 'astro:content';
import Timeline from './components/Timeline.astro';
import TagSidebar from './components/TagSidebar.astro';
import experienceData from '../../data/experience.json';

const projectEntries = await getCollection('projects');
const seenTitles = new Set();
const allEntries = [];

projectEntries.forEach(entry => {
    seenTitles.add(entry.data.title);
    allEntries.push(entry);
});

experienceData.forEach(item => {
    if (!seenTitles.has(item.title)) {
        allEntries.push({
            collection: 'experience_json',
            slug: '',
            data: { ...item }
        });
    }
});

const sortedEvents = allEntries.sort((a, b) => {
  const dateAStart = a.data.date.split('-')[0];
  const dateBStart = b.data.date.split('-')[0];
  const dateA = new Date(dateAStart.replace(/\./g, '-')).getTime();
  const dateB = new Date(dateBStart.replace(/\./g, '-')).getTime();
  return dateB - dateA;
});

const years = [...new Set(sortedEvents.map(e => e.data.date.split('-')[0].split('.')[0]))].sort((a, b) => b.localeCompare(a));

const tagCountMap = {};
sortedEvents.forEach(entry => {
  const tags = entry.data.tags || [];
  tags.forEach(tag => {
    tagCountMap[tag] = (tagCountMap[tag] || 0) + 1;
  });
});

const sortedTags = Object.entries(tagCountMap)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);

const categoryCountMap = {};
sortedEvents.forEach(entry => {
  const category = entry.data.category || '';
  if (category) {
    categoryCountMap[category] = (categoryCountMap[category] || 0) + 1;
  }
});

const sortedCategories = Object.entries(categoryCountMap)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);
---

<div class="md:hidden flex flex-col min-h-[calc(100vh-80px)] bg-transparent">
    <!-- 選項按鈕 -->
    <div class="sticky top-0 z-40 px-3 py-2 bg-[#050b1a]/80 backdrop-blur border-b border-white/10 flex gap-2 overflow-x-auto">
        <button id="tab-intro" class="tab-btn tab-intro px-3 py-2 rounded text-xs font-semibold bg-white/20 text-white border border-white/20 transition-all whitespace-nowrap active">
            自我介紹
        </button>
        <button id="tab-timeline" class="tab-btn tab-timeline px-3 py-2 rounded text-xs font-semibold bg-white/5 text-gray-400 border border-white/10 transition-all hover:text-white whitespace-nowrap">
            時間軸
        </button>
        <button id="tab-filter" class="tab-btn tab-filter px-3 py-2 rounded text-xs font-semibold bg-white/5 text-gray-400 border border-white/10 transition-all hover:text-white whitespace-nowrap">
            篩選
        </button>
    </div>

    <!-- 下方内容 -->
    <div class="flex-1 overflow-y-auto">
        <!-- 自我介紹 -->
        <div id="intro-content" class="p-4 space-y-4">
            <h2 class="text-2xl font-black text-white mb-2">About Me</h2>
            <div class="p-4 rounded-lg bg-white/5 border border-white/10 space-y-3">
                <p class="text-xs text-gray-300 leading-relaxed">
                    我是一位對程式設計充滿熱情的開發者，喜歡透過代碼解決問題和建構有趣的事物。
                </p>
                <p class="text-xs text-gray-300 leading-relaxed">
                    除了編程外，我還喜歡騎單車、打撞球、保齡球、排球和手作等活動。
                </p>
            </div>
        </div>

        <!-- 時間軸 -->
        <div id="timeline-content" class="hidden p-4">
            <h2 class="text-xl font-black text-white mb-4">Timeline</h2>
            {sortedEvents.length > 0 ? (
                <Timeline events={sortedEvents} />
            ) : (
                <p class="text-gray-400 text-center py-8">No data</p>
            )}
        </div>

        <!-- 篩選 -->
        <div id="filter-content" class="hidden p-4">
            <h2 class="text-xl font-black text-white mb-4">Filters</h2>
            <TagSidebar tags={sortedTags} years={years} categories={sortedCategories} />
        </div>
    </div>
</div>

<style>
    @media (max-width: 768px) {
        ::-webkit-scrollbar {
            width: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.3);
            border-radius: 10px;
        }
    }
</style>

<script>
    const tabBtns = document.querySelectorAll('.tab-btn');
    const introContent = document.getElementById('intro-content');
    const timelineContent = document.getElementById('timeline-content');
    const filterContent = document.getElementById('filter-content');

    function showTab(tabName) {
        // 隐藏所有
        introContent?.classList.add('hidden');
        timelineContent?.classList.add('hidden');
        filterContent?.classList.add('hidden');
        tabBtns.forEach(b => {
            b.classList.remove('bg-white/20', 'text-white', 'border-white/20');
            b.classList.add('bg-white/5', 'text-gray-400', 'border-white/10');
        });
        
        // 顯示選中的內容
        const tab = document.getElementById(`tab-${tabName}`);
        if (tabName === 'intro') {
            introContent?.classList.remove('hidden');
        } else if (tabName === 'timeline') {
            timelineContent?.classList.remove('hidden');
        } else if (tabName === 'filter') {
            filterContent?.classList.remove('hidden');
        }
        tab?.classList.add('bg-white/20', 'text-white', 'border-white/20');
        tab?.classList.remove('bg-white/5', 'text-gray-400', 'border-white/10');
    }

    document.getElementById('tab-intro')?.addEventListener('click', () => showTab('intro'));
    document.getElementById('tab-timeline')?.addEventListener('click', () => showTab('timeline'));
    document.getElementById('tab-filter')?.addEventListener('click', () => showTab('filter'));
</script>