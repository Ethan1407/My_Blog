---
import { getCollection } from 'astro:content';
import experienceData from '../../data/experience.json';

const projectEntries = await getCollection('projects');
const seenTitles = new Set();
const allEntries = [];

projectEntries.forEach(entry => {
    seenTitles.add(entry.data.title);
    allEntries.push(entry);
});

experienceData.forEach(item => {
    if (!seenTitles.has(item.title)) {
        allEntries.push({
            collection: 'experience_json',
            slug: '',
            data: { ...item }
        });
    }
});

const sortedEvents = allEntries.sort((a, b) => {
  const dateAStart = a.data.date.split('-')[0];
  const dateBStart = b.data.date.split('-')[0];
  const dateA = new Date(dateAStart.replace(/\./g, '-')).getTime();
  const dateB = new Date(dateBStart.replace(/\./g, '-')).getTime();
  return dateB - dateA;
});
---

<div class='md:hidden flex flex-col min-h-[calc(100vh-80px)] bg-transparent overflow-y-auto custom-scrollbar py-4 px-4'>
    <h2 class='text-3xl font-black text-white mb-1 text-center'>About Me</h2>
    <p class='text-gray-400 text-sm text-center mb-6'>Developer &amp; Creative Thinker</p>

    <div class='space-y-3 flex-1'>
        {sortedEvents.length > 0 ? (
            sortedEvents.map((event, idx) => (
                <div class='p-3 rounded-lg bg-white/5 border border-white/10 hover:bg-white/10 transition-colors'>
                    <div class='flex justify-between items-start gap-3 mb-2'>
                        <h3 class='font-bold text-white text-sm flex-1'>{event.data.title}</h3>
                        <span class='text-blue-400 text-xs font-semibold'>{event.data.date.split('-')[0]}</span>
                    </div>
                    {event.data.description && (
                        <p class='text-gray-300 text-xs leading-relaxed mb-2'>{event.data.description}</p>
                    )}
                    {event.data.tags && event.data.tags.length > 0 && (
                        <div class='flex flex-wrap gap-1'>
                            {event.data.tags.slice(0, 3).map((tag: string) => (
                                <span class='px-2 py-1 text-xs bg-blue-500/20 text-blue-300 rounded-full'>{tag}</span>
                            ))}
                            {event.data.tags.length > 3 && <span class='px-2 py-1 text-xs text-gray-400'>+{event.data.tags.length - 3}</span>}
                        </div>
                    )}
                </div>
            ))
        ) : (
            <p class='text-gray-400 text-center'>No data</p>
        )}
    </div>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.3); }
</style>